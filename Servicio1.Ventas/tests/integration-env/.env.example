# Copiar a .env solo despues de la revision. No contiene contrasenas.
# Usuario exclusivo de esta base, distinto de root.
VENTAS_TEST_USER=
# Rutas absolutas a archivos externos privados: una contrasena por archivo.
# Usar rutas C:/... en Windows. No reutilizar claves de desarrollo/produccion.
VENTAS_TEST_ROOT_PASSWORD_FILE=
VENTAS_TEST_PASSWORD_FILE=
