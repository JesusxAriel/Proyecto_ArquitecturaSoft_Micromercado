@page
@model PuntoMarket.Ventas.Frontend.Pages.Users.IndexModel
@{ ViewData["Title"]="Usuarios"; }
<h1>Usuarios</h1>
<div class="d-flex gap-2 mb-3"><a asp-page="Crear" class="btn btn-primary">Preparar alta</a><a asp-page="Index" class="btn btn-outline-secondary">Consultar listado</a></div>
@if(Model.MensajeGestion is not null){<p class="alert alert-success" role="status">@Model.MensajeGestion</p>}
@if(Model.ErrorGestion is not null){<p class="alert alert-danger" role="alert">@Model.ErrorGestion</p>}
@if(Model.ConfirmarBaja is {} baja){
<section class="card card-body border-danger mb-3" aria-labelledby="confirmar-baja">
<h2 class="h5" id="confirmar-baja">Confirmar baja lógica</h2>
<p>Se desactivará la cuenta @baja.Username (@baja.Correo). Sus registros históricos se conservarán.</p>
<form method="post" asp-page-handler="Baja"><input type="hidden" name="id" value="@baja.Id" />
<label class="form-check-label"><input class="form-check-input" type="checkbox" name="confirmar" value="true" required /> Confirmo que deseo dar de baja esta cuenta.</label>
<div class="mt-3"><button type="submit" class="btn btn-danger">Confirmar baja</button> <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a></div></form>
</section>}
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Usuario</th><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var u in Model.Usuarios){<tr><td>@u.Username</td><td>@u.Nombre @u.Apellido</td><td>@u.Correo</td><td>@u.Rol</td><td>@u.EstadoVisible</td><td>
@if(!Model.EsPropia(u)&&(u.EsPendiente||u.Estado=="ACTIVO")){<a asp-page-handler="ConfirmarBaja" asp-route-id="@u.Id" class="btn btn-outline-danger btn-sm">Dar de baja</a>}
@if(u.EsPendiente&&u.FechaActivacion is null){<form method="post" asp-page-handler="Reenviar" class="d-inline"><input type="hidden" name="id" value="@u.Id" /><button type="submit" class="btn btn-outline-secondary btn-sm">Reenviar activación</button></form>}
</td></tr>}
</tbody></table></div>
@if(Model.Usuarios.Count==0&&Model.ErrorGestion is null){<p>No hay usuarios para mostrar.</p>}
<p class="small text-body-secondary">El alta y el reenvío requieren SMTP real. Un error de correo puede ocurrir después de guardar cambios; consulte el listado antes de repetir una acción.</p>
