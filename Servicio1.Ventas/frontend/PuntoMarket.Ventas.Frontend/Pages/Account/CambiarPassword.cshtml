@page
@model PuntoMarket.Ventas.Frontend.Pages.Account.CambiarPasswordModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<section class="card sale-panel mx-auto" style="max-width:640px">
    <div class="card-body p-4">
        <h1 class="h3">Cambiar contraseña</h1>
        <p>Ingrese su contraseña actual y escriba dos veces la nueva contraseña.</p>
        <p class="text-muted">La nueva contraseña debe tener al menos 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial.</p>
        @if (Model.ErrorCambio is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorCambio</div>
        }
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.ContrasenaActual" class="form-label">Contraseña actual</label>
                <input asp-for="Input.ContrasenaActual" type="password" autocomplete="current-password" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Input.NuevaContrasena" class="form-label">Nueva contraseña</label>
                <input asp-for="Input.NuevaContrasena" type="password" autocomplete="new-password" class="form-control" minlength="8" required />
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmarContrasena" class="form-label">Confirmar nueva contraseña</label>
                <input asp-for="Input.ConfirmarContrasena" type="password" autocomplete="new-password" class="form-control" minlength="8" required />
            </div>
            <button type="submit" class="btn btn-primary">Guardar contraseña</button>
            <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </form>
    </div>
</section>
