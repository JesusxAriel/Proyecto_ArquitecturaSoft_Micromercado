@page
@model PuntoMarket.Ventas.Frontend.Pages.Account.CambiarPasswordModel
@{ ViewData["Title"] = Model.Titulo; }
<section class="card sale-panel mx-auto" style="max-width:560px"><div class="card-body p-4">
<h1 class="h3">@Model.Titulo</h1>
@if (Model.EsObligatorio)
{
    <p>Por seguridad, debe cambiar su contraseña antes de continuar.</p>
}
else
{
    <p>Ingrese su contraseña actual y defina la nueva. Se cerrará su sesión y deberá iniciar sesión con la nueva contraseña.</p>
}
@if (Model.ErrorCambio is not null) { <p class="alert alert-danger" role="alert">@Model.ErrorCambio</p> }
<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Input.ContrasenaActual" class="form-label">Contraseña actual</label><input asp-for="Input.ContrasenaActual" type="password" autocomplete="current-password" class="form-control" /><span asp-validation-for="Input.ContrasenaActual" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.NuevaContrasena" class="form-label">Nueva contraseña</label><input asp-for="Input.NuevaContrasena" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="Input.NuevaContrasena" class="text-danger"></span>
        <div class="form-text">Mínimo 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial.</div></div>
    <div class="mb-3"><label asp-for="Input.ConfirmarContrasena" class="form-label">Confirmar nueva contraseña</label><input asp-for="Input.ConfirmarContrasena" type="password" autocomplete="new-password" class="form-control" /><span asp-validation-for="Input.ConfirmarContrasena" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
</form>
</div></section>
