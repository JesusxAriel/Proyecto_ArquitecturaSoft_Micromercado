@page
@model PuntoMarket.Ventas.Frontend.Pages.Reportes.VentasModel
@{ ViewData["Title"] = "Reportes de ventas"; }
<h1>Reportes de ventas</h1>
<nav class="mb-3" aria-label="Tipos de reporte"><a asp-page="/Reportes/Ventas" class="btn btn-primary">Listado de ventas</a> <a asp-page="/Reportes/Categorias" class="btn btn-outline-primary">Ventas por categoría</a></nav>
<form method="get" class="card card-body mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Filtro.Desde">Desde</label><input asp-for="Filtro.Desde" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Filtro.Hasta">Hasta</label><input asp-for="Filtro.Hasta" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Filtro.Estado">Estado</label><select asp-for="Filtro.Estado" class="form-select"><option value="">Todos</option><option>COMPLETADA</option><option>ANULADA</option></select></div>
        <div class="col-md-3"><label asp-for="Filtro.Tope">Máximo de filas</label><input asp-for="Filtro.Tope" class="form-control" min="1" max="1000" /></div>
        <div class="col-md-6"><label asp-for="Filtro.Cliente">CI/NIT o razón social (opcional)</label><input asp-for="Filtro.Cliente" class="form-control" minlength="2" maxlength="150" /></div>
    </div>
    <div class="mt-3"><button type="submit" class="btn btn-primary">Consultar</button> <button type="submit" name="handler" value="Pdf" class="btn btn-outline-secondary">Descargar PDF</button> <button type="submit" name="handler" value="Excel" class="btn btn-outline-secondary">Descargar Excel</button></div>
</form>
@if (Model.ErrorReporte is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorReporte</div> }
@if (Model.Reporte is { } reporte)
{
    <partial name="_IndicadoresReporte" model="Model.Indicadores" />
    <p>Generado por @reporte.GeneradoPor · @reporte.GeneradoEn.ToString("dd/MM/yyyy HH:mm")</p>
    <p>Completadas: <strong>@reporte.Totales.VentasCompletadas</strong> · Anuladas: <strong>@reporte.Totales.VentasAnuladas</strong> · Total completadas: <strong>Bs @reporte.Totales.MontoTotalDeCompletadas.ToString("N2")</strong> · Promedio: <strong>Bs @reporte.Totales.PromedioPorVenta.ToString("N2")</strong></p>
    <section data-resultados-reporte aria-label="Resultados del reporte">
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Comprobante</th><th>Fecha</th><th>CI/NIT</th><th>Cliente</th><th>Cajero</th><th>Estado</th><th class="text-end">Monto (Bs)</th></tr></thead><tbody>
    @foreach (var fila in reporte.Filas) { <tr><td>@fila.Comprobante</td><td>@fila.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@fila.NitCi</td><td>@fila.RazonSocial</td><td>@fila.Cajero</td><td>@fila.Estado</td><td class="text-end">@fila.Monto.ToString("N2")</td></tr> }
    </tbody></table></div>
    <partial name="_PaginacionReportes" />
    </section>
    @if (reporte.Filas.Count == 0) { <p>No hay ventas para los filtros indicados.</p> }
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/ventas-reglas.js" asp-append-version="true"></script>
    <script src="~/js/reportes-paginacion.js" asp-append-version="true"></script>
}
