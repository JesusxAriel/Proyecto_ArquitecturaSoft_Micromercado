@page
@model PuntoMarket.Ventas.Frontend.Pages.Reportes.CategoriasModel
@{ ViewData["Title"] = "Ventas por categoría"; }

<header class="mb-4">
    <h1 class="page-heading mb-1">Ventas por categoría</h1>
    <p class="text-muted mb-0">Consulte el monto y las unidades vendidas por categoría en un período.</p>
</header>

@if (Model.ErrorReporte is not null)
{
    <div class="alert alert-danger shadow-sm" role="alert">@Model.ErrorReporte</div>
}

<section class="card shadow-sm mb-4" aria-labelledby="filtrosTitulo">
    <div class="card-body">
        <h2 class="h5 card-title mb-3" id="filtrosTitulo">Filtros</h2>
        <form id="filtrosReporte" method="get">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Filtro.Desde" class="form-label">Desde</label>
                    <input asp-for="Filtro.Desde" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Filtro.Hasta" class="form-label">Hasta</label>
                    <input asp-for="Filtro.Hasta" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Filtro.IdCategoria" class="form-label">Categoría</label>
                    <select asp-for="Filtro.IdCategoria" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Id" selected="@(Model.Filtro.IdCategoria == categoria.Id)">@categoria.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Filtro.Top" class="form-label">Primeras categorías (opcional)</label>
                    <input asp-for="Filtro.Top" type="number" class="form-control" min="1" max="100" inputmode="numeric" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-search" aria-hidden="true"></i> Consultar
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

@if (Model.Reporte is { } reporte)
{
    <section class="card shadow-sm mb-4" aria-labelledby="resultadoTitulo">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0" id="resultadoTitulo">Resultado</h2>
                @if (reporte.Filas.Count > 0)
                {
                    <div class="ms-auto d-flex flex-wrap gap-2">
                        <button type="submit" form="filtrosReporte" name="handler" value="Pdf" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Descargar PDF
                        </button>
                        <button type="submit" form="filtrosReporte" name="handler" value="Excel" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Descargar Excel
                        </button>
                    </div>
                }
            </div>

            @if (reporte.Filas.Count == 0)
            {
                <p class="text-center text-muted py-4 mb-0" role="status">Sin resultados para los filtros seleccionados</p>
            }
            else
            {
                <section data-resultados-reporte aria-label="Resultados del reporte">
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-hover align-middle mb-0" aria-labelledby="resultadoTitulo">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Categoría</th>
                                    <th scope="col" class="text-end">Unidades vendidas</th>
                                    <th scope="col" class="text-end text-nowrap">Monto vendido (Bs)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fila in reporte.Filas)
                                {
                                    <tr>
                                        <th scope="row" class="fw-normal">@fila.Categoria</th>
                                        <td class="text-end">@fila.UnidadesVendidas.ToString("N0")</td>
                                        <td class="text-end">@fila.MontoVendido.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <th scope="row">Totales</th>
                                    <td class="text-end">@reporte.Totales.TotalUnidades.ToString("N0")</td>
                                    <td class="text-end">@reporte.Totales.TotalMonto.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <partial name="_PaginacionReportes" />
                </section>

                <p class="my-4">
                    <span class="fw-semibold">Categoría líder:</span>
                    @(reporte.Totales.CategoriaLider ?? "No aplica")
                </p>

                <h3 class="h6 mb-3" id="graficoTitulo">Vista previa del gráfico</h3>
                <div class="grafico-barras" role="img" aria-label="@Model.DescripcionDelGrafico">
                    @foreach (var fila in reporte.Filas)
                    {
                        <div class="grafico-barras__fila" aria-hidden="true">
                            <span class="grafico-barras__etiqueta">@fila.Categoria</span>
                            <span class="grafico-barras__pista">
                                <span class="grafico-barras__relleno" style="width: @(Model.AnchoDeBarra(fila.MontoVendido))%"></span>
                            </span>
                            <span class="grafico-barras__valor">Bs @fila.MontoVendido.ToString("N2")</span>
                        </div>
                    }
                </div>
                <p class="small text-muted mt-3 mb-0">
                    Generado el @reporte.GeneradoEn.ToString("dd/MM/yyyy HH:mm") por @reporte.GeneradoPor.
                </p>
            }
        </div>
    </section>
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/ventas-reglas.js" asp-append-version="true"></script>
    <script src="~/js/reportes-paginacion.js" asp-append-version="true"></script>
}
