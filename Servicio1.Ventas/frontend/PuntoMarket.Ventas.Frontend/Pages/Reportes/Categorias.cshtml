@page
@model PuntoMarket.Ventas.Frontend.Pages.Reportes.CategoriasModel
@{ ViewData["Title"] = "Ventas por categoría"; }
<h1>Ventas por categoría</h1>
<nav class="mb-3" aria-label="Tipos de reporte"><a asp-page="/Reportes/Ventas" class="btn btn-outline-primary">Listado de ventas</a> <a asp-page="/Reportes/Categorias" class="btn btn-primary">Ventas por categoría</a></nav>
<form method="get" class="card card-body mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Filtro.Desde">Desde</label><input asp-for="Filtro.Desde" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Filtro.Hasta">Hasta</label><input asp-for="Filtro.Hasta" type="date" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Filtro.IdCategoria">ID categoría (opcional)</label><input asp-for="Filtro.IdCategoria" class="form-control" min="1" /></div>
        <div class="col-md-3"><label asp-for="Filtro.Top">Primeras categorías (opcional)</label><input asp-for="Filtro.Top" class="form-control" min="1" max="100" /></div>
    </div>
    <div class="mt-3"><button type="submit" class="btn btn-primary">Consultar</button> <button type="submit" name="handler" value="Pdf" class="btn btn-outline-secondary">Descargar PDF</button> <button type="submit" name="handler" value="Excel" class="btn btn-outline-secondary">Descargar Excel</button></div>
</form>
@if (Model.ErrorReporte is not null) { <div class="alert alert-danger" role="alert">@Model.ErrorReporte</div> }
@if (Model.Reporte is { } reporte)
{
    <p>Generado por @reporte.GeneradoPor · @reporte.GeneradoEn.ToString("dd/MM/yyyy HH:mm") · Solo ventas completadas.</p>
    <p>Unidades: <strong>@reporte.Totales.TotalUnidades</strong> · Monto: <strong>Bs @reporte.Totales.TotalMonto.ToString("N2")</strong> · Categoría líder: <strong>@(reporte.Totales.CategoriaLider ?? "Sin datos")</strong></p>
    <section data-resultados-reporte aria-label="Resultados del reporte">
    <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Categoría</th><th>Unidades vendidas</th><th class="text-end">Monto vendido (Bs)</th></tr></thead><tbody>
    @foreach (var fila in reporte.Filas) { <tr><td>@fila.Categoria</td><td>@fila.UnidadesVendidas</td><td class="text-end">@fila.MontoVendido.ToString("N2")</td></tr> }
    </tbody></table></div>
    <partial name="_PaginacionReportes" />
    </section>
    @if (reporte.Filas.Count == 0) { <p>No hay ventas por categoría para los filtros indicados.</p> }
}

@section Scripts {
    <script src="~/js/ventas-reglas.js" asp-append-version="true"></script>
    <script src="~/js/reportes-paginacion.js" asp-append-version="true"></script>
}
