@model IReadOnlyList<PuntoMarket.Ventas.Frontend.Pages.Reportes.IndicadorReporte>

<ul class="indicadores-reporte" role="list" aria-label="Indicadores principales del reporte">
    @foreach (var indicador in Model)
    {
        <li class="indicador-reporte">
            <span class="indicador-reporte__etiqueta">@indicador.Etiqueta</span>
            <strong class="indicador-reporte__valor">@indicador.Valor</strong>
            @if (indicador.Detalle is not null)
            {
                <span class="indicador-reporte__detalle">@indicador.Detalle</span>
            }
        </li>
    }
</ul>
