@{
    var actual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var minimo = ViewData["LayoutMinimo"] is true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PuntoMarket</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/presentacion.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-presentation-only="true" class="@(minimo ? "pagina-minima" : null)">
    <a class="visually-hidden-focusable skip-link" href="#contenido">Ir al contenido</a>
    @if (!minimo)
    {
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-navy fixed-top shadow-sm py-3" aria-label="Navegación principal">
            <div class="container-fluid px-4 navbar-main-grid">
                <div class="marca-instancia d-flex align-items-center">
                    <a class="navbar-brand" asp-page="/Index" aria-label="PuntoMarket, inicio">
                        <img src="~/images/logo.jpg" alt="PuntoMarket" class="navbar-logo" />
                    </a>
                    <span class="badge rounded-pill text-bg-secondary ms-2">Instancia: @Context.Items["ReplicaId"]</span>
                </div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav navbar-center gap-lg-2 mx-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link @(actual == "/Index" ? "active" : "")" aria-current="@(actual == "/Index" ? "page" : null)" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link @(actual == "/Sales/Index" ? "active" : "")" aria-current="@(actual == "/Sales/Index" ? "page" : null)" asp-page="/Sales/Index">Registrar Venta</a></li>
                        <li class="nav-item"><a class="nav-link @(actual == "/Sales/Historial" ? "active" : "")" aria-current="@(actual == "/Sales/Historial" ? "page" : null)" asp-page="/Sales/Historial">Historial</a></li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link @(actual.StartsWith("/Users") ? "active" : "")" asp-page="/Users/Index">Usuarios</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(actual.StartsWith("/Reportes") ? "active" : "")" href="#" id="reportesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reportes</a>
                                <ul class="dropdown-menu" aria-labelledby="reportesDropdown">
                                    <li><a class="dropdown-item" asp-page="/Reportes/Ventas">Listado de ventas</a></li>
                                    <li><a class="dropdown-item" asp-page="/Reportes/Categorias">Ventas por categoría</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
                <div class="navbar-user">
                @if (User.Identity?.IsAuthenticated == true) {
                    var nombreUsuario = User.Identity.Name ?? "";
                    var rolUsuario = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                    var iniciales = nombreUsuario.Length == 0 ? "" : nombreUsuario[..1].ToUpperInvariant();
                    <div class="dropdown">
                        <button type="button" id="userDropdown" class="btn btn-link text-white text-decoration-none dropdown-toggle user-profile-dropdown d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar" aria-hidden="true">@iniciales</span>
                            <span class="d-none d-md-inline user-summary"><span class="fw-semibold user-name">@nombreUsuario</span> <small class="user-role">@rolUsuario</small></span>
                            <span class="visually-hidden d-md-none">Menú de usuario: @nombreUsuario</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" asp-page="/Account/Perfil"><i class="bi bi-person" aria-hidden="true"></i> Mi perfil</a></li>
                            <li><a class="dropdown-item" asp-page="/Account/CambiarPassword"><i class="bi bi-key" aria-hidden="true"></i> Cambiar contraseña</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><form method="post" asp-page="/Account/Logout"><button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Cerrar sesión</button></form></li>
                        </ul>
                    </div>
                } else { <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">Iniciar sesión</a> }
                </div>
            </div>
        </nav>
    </header>
    }
    <main id="contenido" class="container @(minimo ? "py-4" : "pt-4 pb-5")" tabindex="-1">
        @RenderBody()
    </main>
    @if (!minimo)
    {
    <footer class="presentacion-footer border-top text-muted">
        <div class="container py-3">&copy; @DateTime.Now.Year - PuntoMarket <span class="mx-2">&middot;</span> <a asp-page="/Privacy" class="text-muted">Política de Privacidad</a></div>
    </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
