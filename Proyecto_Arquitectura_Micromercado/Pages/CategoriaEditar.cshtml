@page
@model Proyecto_Arquitectura_Micromercado.Pages.CategoriaEditarModel

@{
    ViewData["Title"] = "Editar Categoría";
}

<h1>Editar Categoría</h1>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <p class="text-danger">@Model.MensajeError</p>
}

<form method="post">

    <input type="hidden" asp-for="Categoria.Id" />

    <div class="mb-3">
        <label class="form-label">Nombre *</label>
        <input asp-for="Categoria.Nombre" class="form-control" />
        <span asp-validation-for="Categoria.Nombre"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Código *</label>
        <input asp-for="Categoria.Codigo" class="form-control" />
        <span asp-validation-for="Categoria.Codigo"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Pasillo Ubicación</label>
        <input asp-for="Categoria.PasilloUbicacion"
               class="form-control" />
        <span asp-validation-for="Categoria.PasilloUbicacion"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <input asp-for="Categoria.Descripcion"
               class="form-control" />
        <span asp-validation-for="Categoria.Descripcion"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-page="Categorias" class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
