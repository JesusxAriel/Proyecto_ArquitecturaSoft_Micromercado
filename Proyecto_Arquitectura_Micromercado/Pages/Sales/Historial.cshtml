@page
@model Proyecto_Arquitectura_Micromercado.Pages.Sales.HistorialModel
@{
    ViewData["Title"] = "Historial de ventas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />
}

<header class="sale-heading d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="page-heading mb-0">Historial de ventas</h1>
    <a class="btn btn-outline-primary btn-sm" asp-page="/Sales/Index">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Registrar venta
    </a>
</header>
@Html.AntiForgeryToken()

<section id="historialVentasSeccion" class="card sale-panel" aria-labelledby="historialVentasHeading"
         data-historial-url="@Url.Page("/Sales/Historial", "Historial")"
         data-detalle-url="@Url.Page("/Sales/Historial", "Detalle")"
         data-anular-url="@Url.Page("/Sales/Historial", "AnularVenta")"
         data-comprobante-base="@Url.Content("~/Comprobante/")"
         data-puede-anular="@(Model.PuedeAnular ? "true" : "false")">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <h2 id="historialVentasHeading" class="h5 mb-0">Ventas</h2>
            <div class="d-flex flex-wrap align-items-center gap-3 ms-auto">
                <div class="form-check mb-0">
                    <input id="mostrarAnuladas" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" for="mostrarAnuladas">Mostrar anuladas</label>
                </div>
                <button id="actualizarHistorial" type="button" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Actualizar
                </button>
            </div>
        </div>
        <p id="estadoHistorial" class="visually-hidden" role="status" aria-live="polite"></p>
        <div id="avisoHistorial" class="alert alert-success" role="status" hidden></div>
        <div class="table-responsive rounded-3 border">
            <table class="table table-hover align-middle mb-0" aria-labelledby="historialVentasHeading">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="text-nowrap">Nro. comprobante</th>
                        <th scope="col" class="text-nowrap">Fecha y hora</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Total</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="historialVentas" aria-busy="false">
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="bi bi-receipt d-block fs-2 text-muted mb-2" aria-hidden="true"></i>
                            <p class="text-muted mb-0">Cargando historial…</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <nav id="paginacionHistorial" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3" aria-label="Paginación del historial" hidden>
            <p id="rangoHistorial" class="small text-body-secondary mb-0" role="status" aria-live="polite"></p>
            <div class="btn-group" role="group" aria-label="Cambiar de página">
                <button id="paginaAnterior" type="button" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior
                </button>
                <button id="paginaSiguiente" type="button" class="btn btn-outline-secondary btn-sm">
                    Siguiente <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
        </nav>
        <noscript><p class="text-danger mt-3 mb-0">Active JavaScript para consultar el historial.</p></noscript>
    </div>
</section>

<div class="modal fade" id="detalleVentaModal" tabindex="-1" aria-labelledby="detalleVentaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h2 id="detalleVentaTitulo" class="modal-title fs-5">Detalle de venta</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="detalleVentaError" class="alert alert-danger" role="alert" hidden></div>
                <dl class="row g-2 mb-4">
                    <dt class="col-sm-4">Nro. comprobante</dt>
                    <dd id="detalleVentaComprobante" class="col-sm-8 text-break"></dd>
                    <dt class="col-sm-4">Cliente</dt>
                    <dd id="detalleVentaCliente" class="col-sm-8 text-break"></dd>
                    <dt class="col-sm-4">Fecha y hora</dt>
                    <dd id="detalleVentaFecha" class="col-sm-8"></dd>
                    <dt class="col-sm-4">Cajero</dt>
                    <dd id="detalleVentaUsuario" class="col-sm-8 text-break"></dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8"><span id="detalleVentaEstado" class="badge bg-secondary"></span></dd>
                </dl>
                <h3 id="detalleVentaProductosHeading" class="h6 mb-3">Productos de la venta</h3>
                <div class="table-responsive rounded-3 border">
                    <table class="table align-middle mb-0" aria-labelledby="detalleVentaProductosHeading">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center">Cantidad</th>
                                <th scope="col">Producto</th>
                                <th scope="col">Lote</th>
                                <th scope="col" class="text-end text-nowrap">Precio unitario (Bs)</th>
                                <th scope="col" class="text-end text-nowrap">Subtotal (Bs)</th>
                            </tr>
                        </thead>
                        <tbody id="detalleVentaProductos"></tbody>
                    </table>
                </div>
                <div class="bg-light border rounded p-3 mt-3">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <span class="fw-semibold">Total (Bs)</span>
                        <span id="detalleVentaTotal" class="fw-semibold"></span>
                    </div>
                </div>
                <section id="detalleVentaAnulacion" class="alert alert-danger mt-3 mb-0" aria-labelledby="detalleVentaAnulacionTitulo" hidden>
                    <h3 id="detalleVentaAnulacionTitulo" class="h6">Venta anulada</h3>
                    <dl class="row g-2 mb-0">
                        <dt class="col-sm-4">Motivo</dt>
                        <dd id="detalleVentaMotivo" class="col-sm-8 text-break mb-0"></dd>
                        <dt class="col-sm-4">Anulada por</dt>
                        <dd id="detalleVentaUsuarioAnulacion" class="col-sm-8 text-break mb-0"></dd>
                        <dt class="col-sm-4">Fecha de anulación</dt>
                        <dd id="detalleVentaFechaAnulacion" class="col-sm-8 mb-0"></dd>
                    </dl>
                </section>
            </div>
            <div class="modal-footer">
                <a id="detalleVentaEnlaceComprobante" class="btn btn-outline-primary" target="_blank" rel="noopener" hidden>
                    <i class="bi bi-receipt" aria-hidden="true"></i> Abrir comprobante
                </a>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@if (Model.PuedeAnular)
{
    <div class="modal fade" id="anularVentaModal" tabindex="-1" aria-labelledby="anularVentaTitulo" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h2 id="anularVentaTitulo" class="modal-title fs-5">Anular venta</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="anularVentaCarga" class="alert alert-secondary" role="status">Cargando los datos de la venta…</div>
                    <div id="anularVentaErrorDetalle" class="alert alert-danger" role="alert" hidden></div>
                    <section id="anularVentaResumen" aria-labelledby="anularVentaResumenTitulo" hidden>
                        <h3 id="anularVentaResumenTitulo" class="h6 mb-3">Datos de la venta</h3>
                        <dl class="row g-2 mb-3">
                            <dt class="col-sm-4">Nro. comprobante</dt>
                            <dd id="anularVentaComprobante" class="col-sm-8 text-break"></dd>
                            <dt class="col-sm-4">Fecha y hora</dt>
                            <dd id="anularVentaFecha" class="col-sm-8"></dd>
                            <dt class="col-sm-4">Cliente</dt>
                            <dd id="anularVentaCliente" class="col-sm-8 text-break"></dd>
                            <dt class="col-sm-4">Cajero</dt>
                            <dd id="anularVentaUsuario" class="col-sm-8 text-break"></dd>
                        </dl>
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-sm align-middle mb-0" aria-labelledby="anularVentaResumenTitulo">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="text-center">Cantidad</th>
                                        <th scope="col">Producto</th>
                                        <th scope="col">Lote</th>
                                        <th scope="col" class="text-end text-nowrap">Precio unitario (Bs)</th>
                                        <th scope="col" class="text-end text-nowrap">Subtotal (Bs)</th>
                                    </tr>
                                </thead>
                                <tbody id="anularVentaProductos"></tbody>
                            </table>
                        </div>
                        <div class="d-flex flex-wrap justify-content-between gap-2 bg-light border rounded p-3 mt-3">
                            <span class="fw-semibold">Total (Bs)</span>
                            <span id="anularVentaTotal" class="fw-semibold"></span>
                        </div>
                    </section>
                    <hr />
                    <section aria-labelledby="anularVentaAccionesTitulo">
                        <h3 id="anularVentaAccionesTitulo" class="h6 mb-3">Anulación</h3>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                            La anulación cambiará el estado de la venta a <strong>ANULADA</strong> y devolverá las unidades vendidas al inventario, lote por lote.
                        </div>
                        <div class="mb-3">
                            <label for="anularVentaMotivo" class="form-label">Motivo de la anulación</label>
                            <textarea id="anularVentaMotivo" class="form-control" rows="3" maxlength="255" required aria-describedby="anularVentaHelp"></textarea>
                            <p id="anularVentaHelp" class="form-text mb-0">Obligatorio. Máximo 255 caracteres.</p>
                        </div>
                        <div id="anularVentaError" class="alert alert-danger mb-0" role="alert" hidden></div>
                    </section>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button id="confirmarAnulacionVenta" type="button" class="btn btn-danger" disabled>Confirmar anulación</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/ventas-reglas.js" asp-append-version="true"></script>
    <script src="~/js/historial.js" asp-append-version="true"></script>
}
