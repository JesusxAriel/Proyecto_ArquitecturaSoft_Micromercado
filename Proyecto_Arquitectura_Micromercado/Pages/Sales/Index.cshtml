@page
@model Proyecto_Arquitectura_Micromercado.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Registro de ventas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />
}

<header class="sale-heading d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="page-heading mb-0">Registro de venta</h1>
    <div class="sale-date" aria-label="Fecha y hora de la venta">
        <time>@Model.FechaActual.ToString("dd/MM/yyyy HH:mm")</time>
    </div>
</header>
@Html.AntiForgeryToken()

<div class="row g-4 align-items-start">
    <div class="col-12 col-lg-8">
        <section id="buscadorProductos" class="card sale-panel mb-4" aria-labelledby="productoHeading"
                 data-busqueda-url="@Url.Page("/Sales/Index", "BuscarProductos")">
            <div class="card-body">
                <h2 id="productoHeading" class="h5 mb-3">Productos</h2>
                <label asp-for="Input.BusquedaProducto" class="visually-hidden"></label>
                <div class="input-group">
                    <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
                    <input asp-for="Input.BusquedaProducto" class="form-control" placeholder="Seleccione un cliente primero"
                           autocomplete="off" disabled />
                </div>
                <p id="estadoBusquedaProductos" class="small text-body-secondary mt-2 mb-0" role="status" aria-live="polite"></p>
                <ul id="resultadosProductos" class="resultados-lista list-unstyled mt-2 mb-0" aria-label="Resultados de productos" aria-busy="false"></ul>
                <p id="avisoDetalle" class="small mt-2 mb-0" role="status" aria-live="polite"></p>
                <noscript><p class="text-danger mt-3 mb-0">Active JavaScript para registrar ventas.</p></noscript>
            </div>
        </section>

        <section class="card sale-panel" aria-labelledby="detalleHeading">
            <div class="card-body">
                <h2 id="detalleHeading" class="h5 mb-3">Detalle</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 sale-lines" aria-labelledby="detalleHeading">
                        <thead>
                            <tr>
                                <th scope="col">Producto</th>
                                <th scope="col" class="text-end">Precio (Bs)</th>
                                <th scope="col" class="columna-cantidad">Cantidad</th>
                                <th scope="col" class="text-end">Subtotal (Bs)</th>
                                <th scope="col"><span class="visually-hidden">Quitar</span></th>
                            </tr>
                        </thead>
                        <tbody id="detalleTemporal">
                            <tr>
                                <td colspan="5" class="text-center text-body-secondary py-4">Aún no hay productos</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-4">
        <aside class="sale-aside" aria-label="Resumen de la venta">
            <div class="card sale-panel">
                <div class="card-body">
                    <section id="buscadorClientes" aria-labelledby="clienteHeading"
                             data-busqueda-url="@Url.Page("/Sales/Index", "BuscarClientes")">
                        <h2 id="clienteHeading" class="h6 sale-label">Cliente</h2>
                        <div id="clienteBusqueda">
                            <label asp-for="Input.IdentificacionCliente" class="visually-hidden">Buscar cliente por CI/NIT o razón social</label>
                            <div class="input-group">
                                <input asp-for="Input.IdentificacionCliente" class="form-control"
                                       placeholder="CI/NIT o razón social" autocomplete="off" />
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal"
                                        data-bs-target="#crearClienteModal" title="Registrar cliente nuevo"
                                        aria-label="Registrar cliente nuevo">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                </button>
                            </div>
                            <p id="estadoBusquedaClientes" class="small text-body-secondary mt-2 mb-0" role="status" aria-live="polite"></p>
                            <ul id="resultadosClientes" class="resultados-lista list-unstyled mt-2 mb-0" aria-label="Resultados de clientes" aria-busy="false"></ul>
                        </div>
                        <div id="clienteTarjeta" class="cliente-tarjeta" hidden>
                            <div class="min-w-0">
                                <p id="clienteNombre" class="fw-semibold mb-0 text-break"></p>
                                <p id="clienteDocumento" class="small text-body-secondary mb-0 text-break"></p>
                            </div>
                            <button id="cambiarCliente" type="button" class="btn btn-outline-secondary btn-sm">Cambiar</button>
                        </div>
                        <input asp-for="Input.IdCliente" type="hidden" />
                    </section>

                    <hr class="my-3" />

                    <div class="sale-total-bloque" role="status" aria-live="polite" aria-atomic="true">
                        <p class="sale-label mb-0">Total</p>
                        <p class="sale-total mb-0">Bs <span id="totalGeneral">0,00</span></p>
                        <p class="small text-body-secondary mb-0"><span id="unidadesTotales">0</span> unidad(es)</p>
                    </div>

                    <div class="mt-3">
                        <label for="efectivoPagado" class="form-label sale-label">Efectivo pagado (Bs)</label>
                        <input id="efectivoPagado" class="form-control" type="number" inputmode="decimal" min="0" max="1000000" step="0.01" />
                        <p id="saldoEfectivo" class="small mb-0 mt-1" role="status" aria-live="polite"></p>
                    </div>

                    <p id="estadoVenta" class="alert py-2 px-3 small mt-3 mb-0" role="status" aria-live="polite" hidden></p>

                    <button id="confirmarVenta" type="button" class="btn btn-warning fw-semibold w-100 mt-3" disabled
                            data-registro-url="@Url.Page("/Sales/Index", "RegistrarVenta")"
                            data-comprobante-base="@Url.Content("~/Comprobante/")">Confirmar venta</button>
                </div>
            </div>
        </aside>
    </div>
</div>

<section id="historialVentasSeccion" class="card shadow-sm mt-4" aria-labelledby="historialVentasHeading"
         data-historial-url="@Url.Page("/Sales/Index", "Historial")"
         data-detalle-url="@Url.Page("/Sales/Index", "Detalle")"
         data-anular-url="@Url.Page("/Sales/Index", "AnularVenta")"
         data-puede-anular="@(User.IsInRole(Proyecto_Arquitectura_Micromercado.Application.Security.Roles.Administrador) ? "true" : "false")">
    <div class="card-header bg-dark text-white d-flex flex-wrap align-items-center gap-2 py-3">
        <i class="bi bi-journal-text" aria-hidden="true"></i>
        <h2 id="historialVentasHeading" class="h5 mb-0">Historial de ventas</h2>
        <div class="d-flex flex-wrap align-items-center gap-3 ms-auto">
            <div class="form-check mb-0">
                <input id="mostrarAnuladas" class="form-check-input" type="checkbox" />
                <label class="form-check-label" for="mostrarAnuladas">Mostrar anuladas</label>
            </div>
            <button id="actualizarHistorial" type="button" class="btn btn-outline-light btn-sm">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Actualizar
            </button>
        </div>
    </div>
    <div class="card-body">
        <p id="historialVentasHelp" class="text-muted mb-3">Se muestran las últimas 50 ventas, de la más reciente a la más antigua.</p>
        <p id="estadoHistorial" class="visually-hidden" role="status" aria-live="polite"></p>
        <div id="avisoHistorial" class="alert alert-success" role="status" hidden></div>
        <div class="table-responsive rounded-3 border">
            <table class="table table-hover align-middle mb-0" aria-labelledby="historialVentasHeading" aria-describedby="historialVentasHelp">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="text-nowrap">Nro. comprobante</th>
                        <th scope="col" class="text-nowrap">Fecha y hora</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Total</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="historialVentas" aria-busy="false">
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="bi bi-receipt d-block fs-2 text-muted mb-2" aria-hidden="true"></i>
                            <p class="text-muted mb-3">Cargando historial…</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="modal fade" id="detalleVentaModal" tabindex="-1" aria-labelledby="detalleVentaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h2 id="detalleVentaTitulo" class="modal-title fs-5">Detalle de venta</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Vista de solo lectura.</p>
                <div id="detalleVentaError" class="alert alert-danger" role="alert" hidden></div>
                <dl class="row g-2 mb-4">
                    <dt class="col-sm-4">Nro. comprobante</dt>
                    <dd id="detalleVentaComprobante" class="col-sm-8 text-break">Sin seleccionar</dd>
                    <dt class="col-sm-4">Cliente</dt>
                    <dd id="detalleVentaCliente" class="col-sm-8 text-break">Sin seleccionar</dd>
                    <dt class="col-sm-4">Fecha y hora</dt>
                    <dd id="detalleVentaFecha" class="col-sm-8">Sin seleccionar</dd>
                    <dt class="col-sm-4">Usuario</dt>
                    <dd id="detalleVentaUsuario" class="col-sm-8 text-break">Sin seleccionar</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8"><span id="detalleVentaEstado" class="badge bg-secondary">Sin seleccionar</span></dd>
                </dl>
                <h3 id="detalleVentaProductosHeading" class="h6 mb-3">Productos de la venta</h3>
                <div class="table-responsive rounded-3 border">
                    <table class="table align-middle mb-0" aria-labelledby="detalleVentaProductosHeading">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center">Cantidad</th>
                                <th scope="col">Producto</th>
                                <th scope="col">Lote</th>
                                <th scope="col" class="text-end text-nowrap">Precio unitario (Bs)</th>
                                <th scope="col" class="text-end text-nowrap">Subtotal (Bs)</th>
                            </tr>
                        </thead>
                        <tbody id="detalleVentaProductos">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay productos cargados en esta vista.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="bg-light border rounded p-3 mt-3">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <span class="fw-semibold">Total (Bs)</span>
                        <span id="detalleVentaTotal" class="fw-semibold text-muted">Sin seleccionar</span>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <span>Efectivo pagado (Bs)</span>
                        <span id="detalleVentaEfectivo">Sin seleccionar</span>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <span>Cambio (Bs)</span>
                        <span id="detalleVentaCambio">Sin seleccionar</span>
                    </div>
                </div>
                <section id="detalleVentaAnulacion" class="alert alert-danger mt-3 mb-0" aria-labelledby="detalleVentaAnulacionTitulo" hidden>
                    <h3 id="detalleVentaAnulacionTitulo" class="h6">Venta anulada</h3>
                    <dl class="row g-2 mb-0">
                        <dt class="col-sm-4">Motivo</dt>
                        <dd id="detalleVentaMotivo" class="col-sm-8 text-break mb-0"></dd>
                        <dt class="col-sm-4">Anulada por</dt>
                        <dd id="detalleVentaUsuarioAnulacion" class="col-sm-8 text-break mb-0"></dd>
                        <dt class="col-sm-4">Fecha de anulación</dt>
                        <dd id="detalleVentaFechaAnulacion" class="col-sm-8 mb-0"></dd>
                    </dl>
                </section>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="anularVentaModal" tabindex="-1" aria-labelledby="anularVentaTitulo" aria-describedby="anularVentaMensaje" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h2 id="anularVentaTitulo" class="modal-title fs-5">Anular venta</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="anularVentaMensaje" class="small text-muted">Paso 1: revise los datos de la venta. Paso 2: indique el motivo y confirme la anulación.</p>
                <div id="anularVentaCarga" class="alert alert-secondary" role="status">Cargando los datos de la venta…</div>
                <div id="anularVentaErrorDetalle" class="alert alert-danger" role="alert" hidden></div>
                <section id="anularVentaResumen" aria-labelledby="anularVentaResumenTitulo" hidden>
                    <h3 id="anularVentaResumenTitulo" class="h6 mb-3">Datos de la venta (solo lectura)</h3>
                    <dl class="row g-2 mb-3">
                        <dt class="col-sm-4">Nro. comprobante</dt>
                        <dd id="anularVentaComprobante" class="col-sm-8 text-break"></dd>
                        <dt class="col-sm-4">Fecha y hora</dt>
                        <dd id="anularVentaFecha" class="col-sm-8"></dd>
                        <dt class="col-sm-4">Cliente</dt>
                        <dd id="anularVentaCliente" class="col-sm-8 text-break"></dd>
                        <dt class="col-sm-4">Usuario (cajero)</dt>
                        <dd id="anularVentaUsuario" class="col-sm-8 text-break"></dd>
                    </dl>
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-sm align-middle mb-0" aria-labelledby="anularVentaResumenTitulo">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="text-center">Cantidad</th>
                                    <th scope="col">Producto</th>
                                    <th scope="col">Lote</th>
                                    <th scope="col" class="text-end text-nowrap">Precio unitario (Bs)</th>
                                    <th scope="col" class="text-end text-nowrap">Subtotal (Bs)</th>
                                </tr>
                            </thead>
                            <tbody id="anularVentaProductos"></tbody>
                        </table>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-2 bg-light border rounded p-3 mt-3">
                        <span class="fw-semibold">Total (Bs)</span>
                        <span id="anularVentaTotal" class="fw-semibold"></span>
                    </div>
                </section>
                <hr />
                <section aria-labelledby="anularVentaAccionesTitulo">
                    <h3 id="anularVentaAccionesTitulo" class="h6 mb-3">Anulación</h3>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                        La anulación cambiará el estado de la venta a <strong>ANULADA</strong> y devolverá las unidades vendidas al inventario, lote por lote.
                    </div>
                    <div class="mb-3">
                        <label for="anularVentaMotivo" class="form-label">Motivo de la anulación</label>
                        <textarea id="anularVentaMotivo" class="form-control" rows="3" maxlength="255" required aria-describedby="anularVentaHelp"></textarea>
                        <p id="anularVentaHelp" class="form-text mb-0">Obligatorio. Máximo 255 caracteres.</p>
                    </div>
                    <div id="anularVentaError" class="alert alert-danger mb-0" role="alert" hidden></div>
                </section>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="confirmarAnulacionVenta" type="button" class="btn btn-danger" disabled>Confirmar anulación</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="crearClienteModal" tabindex="-1" aria-labelledby="crearClienteTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form id="crearClienteForm" class="modal-content" novalidate
              data-crear-url="@Url.Page("/Sales/Index", "CrearCliente")">
            <div class="modal-header">
                <h2 id="crearClienteTitulo" class="modal-title fs-5">Registrar cliente</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="crearClienteError" class="alert alert-danger" role="alert" hidden></div>
                <div class="mb-3">
                    <label for="crearClienteNitCi" class="form-label">CI/NIT</label>
                    <input id="crearClienteNitCi" class="form-control" maxlength="30" required autocomplete="off"
                           aria-describedby="crearClienteNitCiError" />
                    <div id="crearClienteNitCiError" class="invalid-feedback" role="alert" hidden></div>
                </div>
                <div class="mb-3">
                    <label for="crearClienteRazonSocial" class="form-label">Razón social</label>
                    <input id="crearClienteRazonSocial" class="form-control" maxlength="150" required autocomplete="off"
                           aria-describedby="crearClienteRazonSocialError" />
                    <div id="crearClienteRazonSocialError" class="invalid-feedback" role="alert" hidden></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="crearClienteGuardar" type="submit" class="btn btn-primary">Guardar cliente</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/ventas-reglas.js" asp-append-version="true"></script>
    <script src="~/js/ventas.js" asp-append-version="true"></script>
}
