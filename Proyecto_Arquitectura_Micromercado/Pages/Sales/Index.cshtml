@page
@model Proyecto_Arquitectura_Micromercado.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Módulo de Ventas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Módulo de Ventas</h2>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Panel para registrar nueva venta (Parte 3.1) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex align-items-center gap-2">
            <i class="bi bi-cart-plus"></i>
            <h5 class="mb-0">Registrar Nueva Venta</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="RegistrarVenta">
                <input type="hidden" name="IdCliente" value="1" />
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Seleccionar Producto</label>
                        <select name="Lineas[0].IdProducto" class="form-select" required>
                            <option value="">-- Seleccionar --</option>
                            @foreach (var prod in Model.ProductosDisponibles)
                            {
                                <option value="@prod.Id">
                                    @prod.Nombre — Stock: @prod.StockCalculado — Precio: Bs. @prod.PrecioVenta.ToString("N2")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Cantidad</label>
                        <input type="number" name="Lineas[0].Cantidad" class="form-control" value="1" min="1" required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning text-dark fw-bold w-100">
                            <i class="bi bi-bag-check me-1"></i> Completar Venta
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Historial de Ventas (Parte 3.2) -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex align-items-center gap-2">
            <i class="bi bi-journal-text"></i>
            <h5 class="mb-0">Historial de Ventas</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>NRO. COMPROBANTE</th>
                            <th>FECHA Y HORA</th>
                            <th>ESTADO</th>
                            <th>TOTAL</th>
                            <th class="text-end pe-4">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Ventas.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay ventas registradas.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var venta in Model.Ventas)
                            {
                                var esAnulada = venta.Estado != null && venta.Estado.StartsWith("ANULAD", StringComparison.OrdinalIgnoreCase);
                                var modalId = $"modalAnular_{venta.Id}";

                                <tr>
                                    <td class="fw-bold">@venta.NroComprobante</td>
                                    <td>@venta.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @(esAnulada ? "bg-danger" : "bg-success")">
                                            @venta.Estado
                                        </span>
                                    </td>
                                    <td class="fw-bold">Bs. @venta.Total.ToString("N2")</td>
                                    <td class="text-end pe-4">
                                        @if (!esAnulada)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" data-bs-target="#@modalId">
                                                <i class="bi bi-x-circle me-1"></i> Anular
                                            </button>

                                            <!-- Modal de Confirmación Estilizado -->
                                            <div class="modal fade text-start" id="@modalId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title">
                                                                <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Anulación
                                                            </h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p class="mb-2">¿Está seguro de que desea anular la venta <strong>#@venta.NroComprobante</strong>?</p>
                                                            <p class="text-muted small mb-0">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                Esta acción cambiará el estado a <strong>ANULADA</strong> y devolverá automáticamente las unidades vendidas al inventario.
                                                            </p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                            <form method="post" asp-page-handler="AnularVenta" class="d-inline">
                                                                <input type="hidden" name="idVenta" value="@venta.Id" />
                                                                <button type="submit" class="btn btn-danger">
                                                                    <i class="bi bi-check-lg me-1"></i> Sí, Anular Venta
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>