@page
@model Proyecto_Arquitectura_Micromercado.Pages.Reportes.ResumenCategoriasModel
@{
    ViewData["Title"] = "Ventas por categoría";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css" asp-append-version="true" />
}

<header class="mb-4">
    <h1 class="page-heading mb-1">Ventas por categoría</h1>
    <p class="text-muted mb-0">Consulte el monto y las unidades vendidas por categoría en un período.</p>
</header>

<div id="regionDeErrores" role="alert">
    @if (!string.IsNullOrWhiteSpace(Model.MensajeDeError))
    {
        <div class="alert alert-danger shadow-sm">@Model.MensajeDeError</div>
    }
</div>

<section class="card shadow-sm mb-4" aria-labelledby="filtrosTitulo">
    <div class="card-body">
        <h2 class="h5 card-title mb-3" id="filtrosTitulo">Filtros</h2>
        <form id="filtrosReporte" method="get" novalidate>
            <input type="hidden" name="Consultar" value="true" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Filtros.Desde" class="form-label"></label>
                    <input asp-for="Filtros.Desde" type="date" class="form-control" />
                    <span asp-validation-for="Filtros.Desde" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Filtros.Hasta" class="form-label"></label>
                    <input asp-for="Filtros.Hasta" type="date" class="form-control" />
                    <span asp-validation-for="Filtros.Hasta" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Filtros.IdCategoria" class="form-label"></label>
                    <select asp-for="Filtros.IdCategoria" asp-items="Model.Categorias" class="form-select">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Filtros.Top" class="form-label"></label>
                    <input asp-for="Filtros.Top" type="number" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="Filtros.Top" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <p id="errorRangoFechas" class="text-danger mb-2" role="alert" hidden></p>
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-search" aria-hidden="true"></i> Consultar
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

@if (Model.Resultado is { } resultado)
{
    <section class="card shadow-sm mb-4" aria-labelledby="resultadoTitulo">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0" id="resultadoTitulo">Resultado</h2>
                @if (resultado.Filas.Count > 0)
                {
                    <div class="ms-auto d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-danger btn-sm" asp-page-handler="DescargarPdf" asp-all-route-data="Model.ParametrosDeConsulta">
                            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Descargar PDF
                        </a>
                        <a class="btn btn-outline-success btn-sm" asp-page-handler="DescargarExcel" asp-all-route-data="Model.ParametrosDeConsulta">
                            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Descargar Excel
                        </a>
                    </div>
                }
            </div>

            @if (resultado.Filas.Count == 0)
            {
                <p class="text-center text-muted py-4 mb-0" role="status">Sin resultados para los filtros seleccionados</p>
            }
            else
            {
                <div class="table-responsive rounded-3 border mb-3">
                    <table class="table table-hover align-middle mb-0" aria-labelledby="resultadoTitulo">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Categoría</th>
                                <th scope="col" class="text-end">Unidades vendidas</th>
                                <th scope="col" class="text-end text-nowrap">Monto vendido (Bs)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in resultado.Filas)
                            {
                                <tr>
                                    <th scope="row" class="fw-normal">@fila.Categoria</th>
                                    <td class="text-end">@fila.UnidadesVendidas.ToString("N0")</td>
                                    <td class="text-end">@fila.MontoVendido.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <th scope="row">Totales</th>
                                <td class="text-end">@resultado.Totales.TotalUnidades.ToString("N0")</td>
                                <td class="text-end">@resultado.Totales.TotalMonto.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p class="mb-4">
                    <span class="fw-semibold">Categoría líder:</span>
                    @(resultado.Totales.CategoriaLider ?? "No aplica")
                </p>

                <h3 class="h6 mb-3" id="graficoTitulo">Vista previa del gráfico</h3>
                <div class="grafico-barras" role="img" aria-label="@Model.DescripcionDelGrafico">
                    @foreach (var fila in resultado.Filas)
                    {
                        <div class="grafico-barras__fila" aria-hidden="true">
                            <span class="grafico-barras__etiqueta">@fila.Categoria</span>
                            <span class="grafico-barras__pista">
                                <span class="grafico-barras__relleno" style="width: @(Model.AnchoDeBarra(fila.MontoVendido))%"></span>
                            </span>
                            <span class="grafico-barras__valor">Bs @fila.MontoVendido.ToString("N2")</span>
                        </div>
                    }
                </div>
                <p class="small text-muted mt-3 mb-0">
                    Generado el @resultado.GeneradoEn.ToString("dd/MM/yyyy HH:mm") por @resultado.GeneradoPor.
                </p>
            }
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/resumen-categorias.js" asp-append-version="true"></script>
}
