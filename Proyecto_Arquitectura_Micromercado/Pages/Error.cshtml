@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar su solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID de la solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cambiar al entorno <strong>Development</strong> muestra información detallada del error ocurrido.
</p>
<p>
    <strong>El entorno Development no debe habilitarse en aplicaciones desplegadas.</strong>
    Puede mostrar información sensible de las excepciones a los usuarios finales.
    Para depurar localmente, habilite el entorno <strong>Development</strong> definiendo la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong>
    y reinicie la aplicación.
</p>
