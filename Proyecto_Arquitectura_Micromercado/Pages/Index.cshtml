@page
@model IndexModel
@{
    ViewData["Title"] = "Panel principal";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-muted small fw-bold mb-1">Panel de control</p>
        <h1 class="page-heading mb-0">Resumen del negocio</h1>
    </div>
</div>

@if (Model.DatabaseWarning is not null)
{
    <div class="alert alert-warning shadow-sm" role="alert">@Model.DatabaseWarning</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card kpi-card shadow-sm h-100" style="--kpi-color: #F59E0B;">
            <div class="card-body">
                <div class="kpi-label">Ventas del día</div>
                <div class="kpi-value mt-2">Bs. @Model.DailySales.ToString("N2")</div>
                <span class="badge badge-ok mt-2">Ventas del día</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card shadow-sm h-100" style="--kpi-color: #10B981;">
            <div class="card-body">
                <div class="kpi-label">Productos activos</div>
                <div class="kpi-value mt-2">@Model.ActiveProductCount</div>
                <a class="btn btn-sm btn-outline-primary rounded-pill fw-semibold mt-2 px-3" asp-page="/Products/Index">Ir a Lista de productos →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card kpi-card shadow-sm h-100" style="--kpi-color: #EF4444;">
            <div class="card-body">
                <div class="kpi-label">Alertas de stock</div>
                <div class="kpi-value mt-2">@Model.LowStockCount</div>
                <span class="badge badge-warning mt-2">Bajo inventario</span>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white border-0 pt-4 px-4">
        <h2 class="h5 fw-bold mb-1">Últimos movimientos</h2>
        <p class="text-muted small mb-0">Actividad reciente del punto de venta</p>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Movimiento</th>
                    <th>Detalle</th>
                    <th>Estado</th>
                    <th class="text-end">Fecha</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-semibold">Sistema listo</td>
                    <td class="text-muted">Panel de control iniciado</td>
                    <td><span class="badge badge-ok">Correcto</span></td>
                    <td class="text-end text-muted">Hoy</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
