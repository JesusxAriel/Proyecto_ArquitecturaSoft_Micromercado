@using Proyecto_Arquitectura_Micromercado.Application.Security
@using Proyecto_Arquitectura_Micromercado.Pages.Shared
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PuntoMarket</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto_Arquitectura_Micromercado.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-is-login="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Login" ? "true" : "false")">
    @if (ViewContext.RouteData.Values["page"]?.ToString() != "/Login")
    {
    <header>
        @{
            var autenticado = User.Identity?.IsAuthenticated == true;
            var esAdministrador = User.IsInRole(Roles.Administrador);
            var rolActual = User.FindFirst(ClaimsDeIdentidad.Rol)?.Value ?? string.Empty;
            var nombreMostrado = Context.Session.GetString(VariablesDeSesion.NombreParaMostrar)
                ?? User.Identity?.Name
                ?? string.Empty;
            var inicioDeSesion = Context.Session.GetString(VariablesDeSesion.InicioDeSesion);
            var iniciales = string.Concat(
                nombreMostrado
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2)
                    .Select(palabra => char.ToUpperInvariant(palabra[0])));
        }
        @{
            var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        }
        <nav class="navbar navbar-expand-lg navbar-dark bg-navy fixed-top shadow-sm py-3">
            <div class="container-fluid px-4 navbar-main-grid">
                <a class="navbar-brand" asp-area="" asp-page="/Index" aria-label="PuntoMarket, ir al inicio">
                    <img src="~/images/logo.jpg" alt="" class="navbar-logo" style="height: 76px; width: auto; object-fit: contain;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav navbar-center mx-auto mb-2 mb-lg-0">
                        @if (esAdministrador)
                        {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(currentPage.StartsWith("/Products", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Categories", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                               href="#" role="button">Inventario</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Products/Index">Lista de productos</a></li>
                                <li><a class="dropdown-item" asp-page="/Products/History">Historial de Cambios</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-page="/Categories/Index">Listado de Categorías</a></li>
                                    <li>
                                        <a class="dropdown-item disabled" href="#" aria-disabled="true" tabindex="-1">
                                            Distribución por Pasillos <span class="badge bg-secondary ms-1">Próximamente</span>
                                        </a>
                                    </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(currentPage.StartsWith("/Suppliers", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                               href="#" role="button">Proveedores</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Suppliers/Index">Directorio de Proveedores</a></li>
                                    <li>
                                        <a class="dropdown-item disabled" href="#" aria-disabled="true" tabindex="-1">
                                            Productos por Proveedor <span class="badge bg-secondary ms-1">Próximamente</span>
                                        </a>
                                    </li>
                            </ul>
                        </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button">Caja y Ventas</a>
                            <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Sales/Index">
                                            Registro de Ventas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-page="/Sales/Historial">
                                            Historial de ventas
                                        </a>
                                    </li>
                                    @if (!esAdministrador)
                                    {
                                        <li><a class="dropdown-item" asp-page="/Products/Catalog">Consultar productos</a></li>
                                    }
                            </ul>
                        </li>
                    </ul>
                </div>
                @if (autenticado)
                {
                    <div class="dropdown ms-auto navbar-user">
                        <button type="button" id="userDropdown"
                                class="btn btn-link text-white text-decoration-none dropdown-toggle user-profile-dropdown d-flex align-items-center gap-2"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar" aria-label="Usuario @nombreMostrado">@iniciales</span>
                            <span class="d-none d-md-block text-start">
                                <span class="d-block fw-semibold user-name">@nombreMostrado</span>
                                <small class="d-block user-role">@rolActual</small>
                                @if (inicioDeSesion is not null)
                                {
                                    <small class="d-block text-white-50">Inicio: @inicioDeSesion</small>
                                }
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" asp-page="/Logout">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>
    }
    <div class="container">
        <main role="main" class="pt-4 pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer border-top text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - PuntoMarket &middot;
            <a asp-page="/Privacy" class="text-muted">Política de Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var navbar = document.querySelector('.navbar.fixed-top');
            if (!navbar) {
                return;
            }

            var menu = document.getElementById('mainNavigation');

            function publishNavbarHeight() {
                if (menu && (menu.classList.contains('show') || menu.classList.contains('collapsing'))) {
                    return;
                }

                document.documentElement.style.setProperty('--navbar-height', navbar.offsetHeight + 'px');
            }

            publishNavbarHeight();
            window.addEventListener('resize', publishNavbarHeight);
            if ('ResizeObserver' in window) {
                new ResizeObserver(publishNavbarHeight).observe(navbar);
            }
        })();
    </script>
    <script>
        (function () {
            var nav = document.querySelector('.navbar-nav.navbar-center');
            if (!nav) {
                return;
            }

            var items = nav.querySelectorAll('.nav-item.dropdown');

            function unlockAll() {
                items.forEach(function (item) {
                    item.classList.remove('fijo');
                    item.classList.remove('hover-suppressed');
                    var toggle = item.querySelector('.nav-link.dropdown-toggle');
                    if (toggle) {
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
                nav.classList.remove('nav-locked');
            }

            items.forEach(function (item) {
                var toggle = item.querySelector('.nav-link.dropdown-toggle');
                if (!toggle) {
                    return;
                }

                item.addEventListener('mouseleave', function () {
                    item.classList.remove('hover-suppressed');
                });

                toggle.addEventListener('click', function (event) {
                    event.preventDefault();

                    var wasLocked = item.classList.contains('fijo');

                    unlockAll();

                    if (!wasLocked) {
                        item.classList.add('fijo');
                        toggle.setAttribute('aria-expanded', 'true');
                        nav.classList.add('nav-locked');
                    } else {
                        item.classList.add('hover-suppressed');
                    }
                });

                item.querySelectorAll('.dropdown-item:not(.disabled)').forEach(function (link) {
                    link.addEventListener('click', unlockAll);
                });
            });

            document.addEventListener('click', function (event) {
                var clickedInside = Array.prototype.some.call(items, function (item) {
                    return item.contains(event.target);
                });

                if (!clickedInside) {
                    unlockAll();
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
