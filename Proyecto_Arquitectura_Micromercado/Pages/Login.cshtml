@page
@model Proyecto_Arquitectura_Micromercado.Pages.LoginModel
@{
    ViewData["Title"] = "Ingresar";
}

<div class="login-shell">
    <div class="card login-card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="login-icon mb-3">🛒</div>
                <h1 class="h3 fw-bold">Punto Casero POS</h1>
                <p class="text-muted mb-0">Ingresa para continuar</p>
            </div>
            <form id="loginForm" class="needs-validation">
                <div class="mb-3">
                    <label for="username" class="form-label">Usuario</label>
                    <input id="username" name="username" class="form-control" value="admin" required />
                    <div class="invalid-feedback">Ingresa tu usuario.</div>
                </div>
                <div class="mb-4">
                    <label for="password" class="form-label">Contraseña</label>
                    <input id="password" name="password" type="password" class="form-control" value="admin" required />
                    <div class="invalid-feedback">Ingresa tu contraseña.</div>
                </div>

                @section Scripts {
                    <script>
                        $('#loginForm').on('submit', function (event) {
                            event.preventDefault();
                            if (!this.checkValidity()) {
                                this.classList.add('was-validated');
                                return;
                            }

                            localStorage.setItem('puntoCaseroSession', 'admin');
                            window.location.href = '/Index';
                        });
                    </script>
                }
                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </form>
        </div>
    </div>
</div>
