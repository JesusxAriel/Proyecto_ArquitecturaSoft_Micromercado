@page
@model Proyecto_Arquitectura_Micromercado.Pages.LoginModel
@{
    ViewData["Title"] = "Ingresar";
}

<div class="login-shell">
    <div class="card login-card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <img src="~/images/logo.jpg" alt="PuntoMarket" class="mb-3" style="height: 96px; width: auto; object-fit: contain;" />
                <h1 class="h3 fw-bold">PuntoMarket</h1>
                <p class="text-muted mb-0">Ingrese para continuar</p>
            </div>

            @if (Model.SesionVencida && Model.MensajeDeError is null)
            {
                <div class="alert alert-warning" role="alert">Su sesión venció. Inicie sesión nuevamente para continuar.</div>
            }

            @if (Model.MensajeDeError is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.MensajeDeError</div>
            }

            <form method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Input.Usuario" class="form-label"></label>
                    <input asp-for="Input.Usuario" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Usuario" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.Contrasena" class="form-label"></label>
                    <input asp-for="Input.Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Contrasena" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Ingresar</button>
            </form>
        </div>
    </div>
</div>
