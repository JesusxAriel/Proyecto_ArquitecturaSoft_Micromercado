@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categorías";
}

<h1 class="page-heading mb-4">Categorías</h1>

<div class="mb-3">
    <a asp-page="/Categories/Create"
       class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Agregar categoría
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">
        No existen categorías activas registradas.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Código</th>
                <th>Pasillo</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Code</td>
                    <td>@(category.AisleLocation ?? "Sin ubicación")</td>
                    <td>@(category.Description ?? "Sin descripción")</td>

                    <td>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm edit-category-button"
                                title="Editar"
                                aria-label="Editar @category.Name"
                                data-bs-toggle="modal"
                                data-bs-target="#editCategoryModal"
                                data-id="@category.Id"
                                data-name="@category.Name"
                                data-code="@category.Code"
                                data-aisle="@category.AisleLocation"
                                data-description="@category.Description">
                            <i class="bi bi-pencil-square"></i>
                        </button>

                        <a asp-page="/Categories/Delete"
                           asp-route-id="@category.Id"
                           class="btn btn-outline-danger btn-sm"
                           title="Eliminar"
                           aria-label="Eliminar @category.Name">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="modal fade"
     id="editCategoryModal"
     tabindex="-1"
     aria-labelledby="editCategoryLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Edit"
                  class="modal-form">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h2 class="modal-title h5"
                        id="editCategoryLabel">
                        Editar categoría
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="EditCategory.Id"
                           id="editCategoryId" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="mb-3">

                        <label for="editCategoryName"
                               class="form-label">
                            Nombre *
                        </label>

                        <input type="text"
                               name="EditCategory.Name"
                               id="editCategoryName"
                               class="form-control"
                               required
                               maxlength="150"
                               data-validate-input
                               data-category-name="true"
                               pattern="^(?=.*[A-Za-zÁÉÍÓÚáéíóúÑñ])[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s\-&amp;]+$"
                               title="El nombre debe contener letras y solo puede incluir letras, números, espacios, guiones y &amp;." />

                        <div class="input-error text-danger small d-none"></div>

                    </div>

                    <div class="mb-3">

                        <label for="editCategoryCode"
                               class="form-label">
                            Código *
                        </label>

                        <input type="text"
                               name="EditCategory.Code"
                               id="editCategoryCode"
                               class="form-control"
                               required
                               maxlength="20"
                               data-validate-input
                               data-category-code="true"
                               pattern="^[A-Za-z0-9\-]+$"
                               title="El código solo puede contener letras, números y guiones." />

                        <div class="input-error text-danger small d-none"></div>

                    </div>

                    <div class="mb-3">

                        <label for="editCategoryAisle"
                               class="form-label">
                            Ubicación en pasillo
                        </label>

                        <input type="text"
                               name="EditCategory.AisleLocation"
                               id="editCategoryAisle"
                               class="form-control"
                               maxlength="20"
                               data-validate-input
                               data-category-aisle="true"
                               pattern="^[Pp][Aa][Ss][Ii][Ll][Ll][Oo] [1-8]$"
                               title="La ubicación debe tener el formato Pasillo 1 hasta Pasillo 8." />

                        <div class="input-error text-danger small d-none"></div>

                    </div>

                    <div class="mb-3">

                        <label for="editCategoryDescription"
                               class="form-label">
                            Descripción
                        </label>

                        <input type="text"
                               name="EditCategory.Description"
                               id="editCategoryDescription"
                               class="form-control"
                               maxlength="255"
                               data-validate-input
                               data-category-description="true"
                               pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s.,\-()]+$"
                               title="La descripción solo puede contener letras, números, espacios, puntos, comas, guiones y paréntesis." />

                        <div class="input-error text-danger small d-none"></div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-save-button">
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function normalizeCategorySpaces(value) {
            return value.replace(/\s+/g, ' ');
        }

        function toCategoryTitleCase(value) {
            const lowerWords = [
                'y',
                'de',
                'del',
                'la',
                'las',
                'el',
                'los',
                'en'
            ];

            return value
                .toLowerCase()
                .split(' ')
                .map((word, index) => {

                    if (index > 0 && lowerWords.includes(word)) {
                        return word;
                    }

                    return word.charAt(0).toUpperCase() + word.slice(1);
                })
                .join(' ');
        }

        function validateCategoryField(input) {

            const error = $(input).siblings('.input-error');
            const value = input.value;
            let message = '';

            if (input.required && !value.trim()) {
                message = 'Este campo es obligatorio.';
            }

            if (!message &&
                input.hasAttribute('data-category-name')) {

                if (/^\s/.test(value)) {
                    message = 'No se permiten espacios al inicio.';
                }
                else if (/\s{2,}/.test(value)) {
                    message = 'No se permiten espacios dobles.';
                }
                else if (
                    value &&
                    !/^(?=.*[A-Za-zÁÉÍÓÚáéíóúÑñ])[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s\-&]+$/.test(value)
                ) {
                    message =
                        'El nombre contiene caracteres no permitidos.';
                }
            }

            if (!message &&
                input.hasAttribute('data-category-code')) {

                if (/^\s/.test(value)) {
                    message = 'No se permiten espacios al inicio.';
                }
                else if (/\s/.test(value)) {
                    message = 'El código no puede contener espacios.';
                }
                else if (
                    value &&
                    !/^[A-Za-z0-9\-]+$/.test(value)
                ) {
                    message =
                        'El código solo puede contener letras, números y guiones.';
                }
            }

            if (!message &&
                input.hasAttribute('data-category-aisle')) {

                if (/^\s/.test(value)) {
                    message = 'No se permiten espacios al inicio.';
                }
                else if (/\s{2,}/.test(value)) {
                    message = 'No se permiten espacios dobles.';
                }
                else if (
                    value &&
                    !/^[Pp][Aa][Ss][Ii][Ll][Ll][Oo] [1-8]$/.test(value)
                ) {
                    message =
                        'La ubicación debe tener el formato Pasillo 1 hasta Pasillo 8.';
                }
            }

            if (!message &&
                input.hasAttribute('data-category-description')) {

                if (/^\s/.test(value)) {
                    message = 'No se permiten espacios al inicio.';
                }
                else if (/\s{2,}/.test(value)) {
                    message = 'No se permiten espacios dobles.';
                }
                else if (
                    value &&
                    !/^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s.,\-()]+$/.test(value)
                ) {
                    message =
                        'La descripción solo puede contener letras, números, espacios, puntos, comas, guiones y paréntesis.';
                }
            }

            if (message) {

                error
                    .text(message)
                    .removeClass('d-none');

                input.setCustomValidity(message);

                return false;
            }

            error
                .text('')
                .addClass('d-none');

            input.setCustomValidity('');

            return true;
        }

        $('.edit-category-button').on('click', function() {

            const button = $(this);

            $('#editCategoryId').val(button.data('id'));
            $('#editCategoryName').val(button.data('name'));
            $('#editCategoryCode').val(button.data('code'));
            $('#editCategoryAisle').val(button.data('aisle') || '');
            $('#editCategoryDescription').val(button.data('description') || '');

            $('#editCategoryModal .input-error')
                .text('')
                .addClass('d-none');

            $('#editCategoryModal input').each(function() {
                this.setCustomValidity('');
            });
        });

        $(
            '#editCategoryModal [data-category-name], ' +
            '#editCategoryModal [data-category-code], ' +
            '#editCategoryModal [data-category-aisle], ' +
            '#editCategoryModal [data-category-description]'
        )
            .on('input', function() {

                validateCategoryField(this);

            })
            .on('blur', function() {

                let value = this.value.trim();

                value = normalizeCategorySpaces(value);

                if (this.hasAttribute('data-category-name')) {
                    value = toCategoryTitleCase(value);
                }

                if (this.hasAttribute('data-category-code')) {
                    value = value.toUpperCase();
                }

                if (this.hasAttribute('data-category-aisle')) {

                    const match =
                        value.match(/^pasillo\s+([1-8])$/i);

                    if (match) {
                        value = 'Pasillo ' + match[1];
                    }
                }

                this.value = value;

                validateCategoryField(this);
            });
    </script>
}