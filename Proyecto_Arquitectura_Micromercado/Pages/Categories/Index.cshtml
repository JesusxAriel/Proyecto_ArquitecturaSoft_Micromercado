@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<div class="mb-3">
    <a asp-page="/Categories/Create"
       class="btn btn-primary">
        + Add Category
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">
        @Model.MensajeError
    </div>
}

@if (Model.ListCategorias.Count == 0)
{
    <div class="alert alert-info">
        No active categories found.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Code</th>
                <th>Aisle</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var categoria in Model.ListCategorias)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td>@categoria.Codigo</td>
                    <td>@(categoria.PasilloUbicacion ?? "No location")</td>
                    <td>@(categoria.Descripcion ?? "No description")</td>

                    <td>
                        <a asp-page="/Categories/Edit"
                           asp-route-id="@categoria.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form method="post"
                              asp-page-handler="Eliminar"
                              asp-route-id="@categoria.Id"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this category?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}