@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

<div class="mb-3">
    <a asp-page="/Categories/Create"
       class="btn btn-primary">
        + Agregar categoría
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">
        No existen categorías activas registradas.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Código</th>
                <th>Pasillo</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Code</td>
                    <td>@(category.AisleLocation ?? "Sin ubicación")</td>
                    <td>@(category.Description ?? "Sin descripción")</td>

                    <td>
                        <a asp-page="/Categories/Edit"
                           asp-route-id="@category.Id"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-page="/Categories/Delete"
                           asp-route-id="@category.Id"
                           class="btn btn-danger btn-sm">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}