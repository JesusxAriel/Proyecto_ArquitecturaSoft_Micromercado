@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="page-heading mb-0">Categorías</h1>
    <button type="button" class="btn btn-warning fw-semibold px-3"
            onclick="window.location.href='@Url.Page("/Categories/Create")'">
        <i class="bi bi-plus-lg me-1"></i>Añadir
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success shadow-sm" role="alert">@Model.StatusMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Categories.Count == 0)
{
    <div class="alert alert-info">No existen categorías activas registradas.</div>
}
else
{
    <div class="mb-3">
        <label for="categorySearch" class="visually-hidden">Buscar categorías</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
            <input id="categorySearch" class="form-control" type="search"
                   placeholder="Buscar por nombre, código o pasillo..." autocomplete="off" />
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded-3">
        <table id="categoriesTable" class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Pasillo</th>
                    <th>Descripción</th>
                    <th class="text-end pe-3">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Code</td>
                    <td>@(category.AisleLocation ?? "Sin ubicación")</td>
                    <td>@(category.Description ?? "Sin descripción")</td>
                    <td class="text-end pe-3">
                        <div class="d-flex justify-content-end align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-outline-warning edit-category-button"
                                    title="Editar" aria-label="Editar @category.Name"
                                    data-bs-toggle="modal" data-bs-target="#editCategoryModal"
                                    data-id="@category.Id" data-name="@category.Name"
                                    data-code="@category.Code" data-aisle="@category.AisleLocation"
                                    data-description="@category.Description">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <a asp-page="/Categories/Delete" asp-route-id="@category.Id"
                               class="btn btn-sm btn-outline-danger" title="Eliminar"
                               aria-label="Eliminar @category.Name">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="editCategoryModal" tabindex="-1"
     aria-labelledby="editCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit" class="modal-form">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="editCategoryLabel">Editar categoría</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditCategory.Id" id="editCategoryId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label for="editCategoryName" class="form-label">Nombre *</label>
                        <input asp-for="EditCategory.Name" id="editCategoryName"
                               class="form-control" required data-sanitize="text"
                               data-validate-input
                               pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-&amp;]+$" />
                        <div class="input-error text-danger small d-none"></div>
                    </div>
                    <div class="mb-3">
                        <label for="editCategoryCode" class="form-label">Código *</label>
                        <input asp-for="EditCategory.Code" id="editCategoryCode"
                               class="form-control" required data-sanitize="text"
                               data-validate-input pattern="^[A-Za-z0-9\-]+$" />
                        <div class="input-error text-danger small d-none"></div>
                    </div>
                    <div class="mb-3">
                        <label for="editCategoryAisle" class="form-label">Ubicación en pasillo</label>
                        <input asp-for="EditCategory.AisleLocation" id="editCategoryAisle"
                               class="form-control" data-sanitize="text"
                               data-validate-input pattern="^[Pp][Aa][Ss][Ii][Ll][Ll][Oo] [1-8]$" />
                        <div class="input-error text-danger small d-none"></div>
                    </div>
                    <div class="mb-3">
                        <label for="editCategoryDescription" class="form-label">Descripción</label>
                        <input asp-for="EditCategory.Description" id="editCategoryDescription"
                               class="form-control" data-sanitize="text"
                               data-capitalize="true" data-validate-input
                               pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ0-9\s.,\-()]+$" />
                        <div class="input-error text-danger small d-none"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary modal-save-button">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.edit-category-button').on('click', function () {
            const button = $(this);
            $('#editCategoryId').val(button.attr('data-id'));
            $('#editCategoryName').val(button.attr('data-name'));
            $('#editCategoryCode').val(button.attr('data-code'));
            $('#editCategoryAisle').val(button.attr('data-aisle') || '');
            $('#editCategoryDescription').val(button.attr('data-description') || '');
            $('#editCategoryModal .input-error').text('').addClass('d-none');
            $('#editCategoryModal input').each(function () {
                this.setCustomValidity('');
            });
            $('#editCategoryModal [data-validate-input]').trigger('input');
        });

        $('#categorySearch').on('input', function () {
            const query = $(this).val().toString().toLocaleLowerCase();
            $('#categoriesTable tbody tr').each(function () {
                $(this).toggle($(this).text().toLocaleLowerCase().includes(query));
            });
        });
    </script>
}
