@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.CreateModel

@{
    ViewData["Title"] = "Agregar categoría";
}

<div class="modal d-block modal-shell" tabindex="-1" aria-modal="true" role="dialog">
<div class="modal-dialog modal-dialog-centered"><div class="modal-content shadow"><div class="modal-header">
<h1 class="modal-title h5">Agregar categoría</h1>
<a asp-page="/Categories/Index" class="btn-close" aria-label="Cerrar"></a>
</div><div class="modal-body">

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<form method="post" class="needs-validation modal-form">

    <partial name="_CategoryForm"
             model="Model.Category" />

    <button type="submit"
            class="btn btn-primary">
        Guardar
    </button>

    <a asp-page="/Categories/Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form></div></div></div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}