@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.DeleteModel

@{
    ViewData["Title"] = "Eliminar categoría";
}

<div class="modal d-block modal-shell" tabindex="-1" aria-modal="true" role="dialog">
<div class="modal-dialog modal-dialog-centered"><div class="modal-content shadow"><div class="modal-header">
<h1 class="modal-title h5">Eliminar categoría</h1>
<a asp-page="/Categories/Index" class="btn-close" aria-label="Cerrar"></a>
</div><div class="modal-body">

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<dl class="row">

    <dt class="col-sm-3">
        Nombre
    </dt>
    <dd class="col-sm-9">
        @Model.Category.Name
    </dd>

    <dt class="col-sm-3">
        Código
    </dt>
    <dd class="col-sm-9">
        @Model.Category.Code
    </dd>

    <dt class="col-sm-3">
        Ubicación
    </dt>
    <dd class="col-sm-9">
        @(Model.Category.AisleLocation ?? "Sin ubicación")
    </dd>

    <dt class="col-sm-3">
        Descripción
    </dt>
    <dd class="col-sm-9">
        @(Model.Category.Description ?? "Sin descripción")
    </dd>

</dl>

<p class="mb-0">¿Estás seguro de que querés eliminar <strong>@Model.Category.Name</strong>? Esta acción no se puede deshacer.</p>

<form method="post" id="deleteCategoryForm" class="mt-3">

    <input type="hidden"
           name="id"
           value="@Model.Category.Id" />

    <div class="d-flex justify-content-end gap-2">
        <a asp-page="/Categories/Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sí, eliminar</button>
    </div>

</form></div></div></div></div>