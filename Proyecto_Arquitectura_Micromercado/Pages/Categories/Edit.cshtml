@page
@model Proyecto_Arquitectura_Micromercado.Pages.Categories.EditModel

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <p class="text-danger">@Model.MensajeError</p>
}

<form method="post">

    <input type="hidden" asp-for="Categoria.Id" />

    <div class="mb-3">
        <label class="form-label">Name *</label>
        <input asp-for="Categoria.Nombre"
               class="form-control" />
        <span asp-validation-for="Categoria.Nombre"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Code *</label>
        <input asp-for="Categoria.Codigo"
               class="form-control" />
        <span asp-validation-for="Categoria.Codigo"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Aisle Location</label>
        <input asp-for="Categoria.PasilloUbicacion"
               class="form-control" />
        <span asp-validation-for="Categoria.PasilloUbicacion"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <input asp-for="Categoria.Descripcion"
               class="form-control" />
        <span asp-validation-for="Categoria.Descripcion"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="/Categories/Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}