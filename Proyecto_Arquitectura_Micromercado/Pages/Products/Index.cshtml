@page
@model Proyecto_Arquitectura_Micromercado.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="page-heading mb-0">Productos</h1>
    <a class="btn btn-primary" asp-page="/Products/Create">Nuevo producto</a>
</div>

@if (Model.DatabaseWarning is not null)
{
    <div class="alert alert-warning shadow-sm" role="alert">@Model.DatabaseWarning</div>
}

<div class="table-responsive shadow-sm rounded-3">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Presentación</th>
            <th>Categoría</th>
            <th>Proveedor</th>
            <th>Precio</th>
            <th>Stock mínimo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Nombre</td>
            <td>@product.EmpaquePresentacion</td>
            <td>@product.NombreCategoria</td>
            <td>@product.NombreProveedor</td>
            <td>@product.PrecioVenta.ToString("N2")</td>
            <td>@product.StockMinimo</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-page="/Products/Edit" asp-route-id="@product.Id">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="/Products/Delete" asp-route-id="@product.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (Model.Products.Count == 0)
{
    <p class="text-muted">No hay productos activos registrados.</p>
}
