@page
@using Microsoft.AspNetCore.Mvc.Rendering
@using Proyecto_Arquitectura_Micromercado.Domain.Common
@model Proyecto_Arquitectura_Micromercado.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="page-heading mb-0">Productos</h1>

    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Products/History" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i>Historial
        </a>

        <button type="button"
                class="btn btn-warning fw-semibold px-3"
                data-bs-toggle="modal"
                data-bs-target="#createProductModal">
            <i class="bi bi-plus-lg me-1"></i>Añadir
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible shadow-sm fade show" role="alert" id="statusAlert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="mb-3" id="productSearchForm">
    <input type="hidden" name="Tamano" value="@Model.Tamano" />

    <label for="productSearch" class="visually-hidden">
        Buscar productos
    </label>

    <div class="input-group">
        <span class="input-group-text">
            <i class="bi bi-search" aria-hidden="true"></i>
        </span>

        <input id="productSearch"
               name="Q"
               value="@Model.Q"
               class="form-control"
               type="search"
               placeholder="Buscar por nombre, empaque, categoría o proveedor..."
               autocomplete="off" />
    </div>
</form>

@if (Model.DatabaseWarning is not null)
{
    <div class="alert alert-warning shadow-sm" role="alert">
        @Model.DatabaseWarning
    </div>
}

<div class="table-responsive products-table-container shadow-sm rounded-3">
    <table id="productsTable" class="table table-hover align-middle mb-0">
        <thead class="products-table-header">
            <tr>
                <th>Nombre</th>
                <th>Empaque</th>
                <th>Categoría</th>
                <th>Proveedor</th>
                <th class="text-center">Precio <span class="th-unit">(Bs)</span></th>
                <th class="text-center" style="min-width: 120px;">Stock mínimo</th>
                <th class="text-end pe-3">ACCIONES</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Nombre</td>
                    <td>@product.EmpaquePresentacion</td>
                    <td>@product.NombreCategoria</td>
                    <td>@product.NombreProveedor</td>

                    <td class="text-center">
                        @product.PrecioVenta.ToString("N2")
                    </td>

                    <td class="text-center" style="min-width: 120px;">
                        @product.StockMinimo
                    </td>

                    <td class="text-end pe-3">
                        <div class="d-flex justify-content-end align-items-center gap-1">

                            <button type="button"
                                    class="btn btn-sm btn-outline-warning edit-product-button"
                                    title="Editar"
                                    aria-label="Editar @product.Nombre"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editProductModal"
                                    data-id="@product.Id"
                                    data-name="@product.Nombre"
                                    data-packaging="@product.IdEmpaque"
                                    data-sale-price="@product.PrecioVenta.ToString("0.00")"
                                    data-cost-price="@product.PrecioCosto.ToString("0.00")"
                                    data-min-stock="@product.StockMinimo"
                                    data-category="@product.IdCategoria"
                                    data-supplier="@product.IdProveedor">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger delete-product-button"
                                    title="Eliminar"
                                    aria-label="Eliminar @product.Nombre"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteProductModal"
                                    data-id="@product.Id"
                                    data-name="@product.Nombre">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    var paged = Model.PagedProducts;
    var firstShown = Math.Max(1, paged.Page - 2);
    var lastShown = Math.Min(paged.TotalPages, paged.Page + 2);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3" id="productsPager">
    <div class="text-muted small">
        @if (paged.TotalCount == 0)
        {
            <text>0 productos</text>
        }
        else
        {
            <text>Mostrando @paged.FirstItemNumber–@paged.LastItemNumber de @paged.TotalCount productos</text>
        }
    </div>

    <div class="d-flex flex-wrap align-items-center gap-3">
        <form method="get" class="d-flex align-items-center gap-2 mb-0">
            <input type="hidden" name="Q" value="@Model.Q" />
            <label for="pageSizeSelect" class="small text-muted mb-0">Por página</label>
            <select id="pageSizeSelect" name="Tamano" class="form-select form-select-sm w-auto">
                @foreach (var size in PageSizes.Allowed)
                {
                    <option value="@size" selected="@(size == paged.PageSize)">@size</option>
                }
            </select>
        </form>

        <nav aria-label="Paginación de productos">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(paged.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-page="/Products/Index"
                       asp-route-Pagina="@(paged.Page - 1)" asp-route-Tamano="@paged.PageSize" asp-route-Q="@Model.Q"
                       aria-label="Anterior">&laquo;</a>
                </li>
                @for (var number = firstShown; number <= lastShown; number++)
                {
                    <li class="page-item @(number == paged.Page ? "active" : "")">
                        <a class="page-link" asp-page="/Products/Index"
                           asp-route-Pagina="@number" asp-route-Tamano="@paged.PageSize" asp-route-Q="@Model.Q">@number</a>
                    </li>
                }
                <li class="page-item @(paged.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-page="/Products/Index"
                       asp-route-Pagina="@(paged.Page + 1)" asp-route-Tamano="@paged.PageSize" asp-route-Q="@Model.Q"
                       aria-label="Siguiente">&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
</div>


<!-- ========================================================= -->
<!-- MODAL CREAR PRODUCTO                                      -->
<!-- ========================================================= -->

<div class="modal fade"
     id="createProductModal"
     tabindex="-1"
     aria-labelledby="createProductLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Create"
                  id="createProductForm"
                  class="modal-form"
                  novalidate
                  autocomplete="off">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Pagina" />
                <input type="hidden" asp-for="Tamano" />
                <input type="hidden" asp-for="Q" />

                <div class="modal-header">

                    <h2 class="modal-title h5" id="createProductLabel">
                        Nuevo producto
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-8">

                            <label for="createProductName"
                                   class="form-label">
                                Nombre *
                            </label>

                            <input asp-for="CreateProduct.Nombre"
                                   id="createProductName"
                                   class="form-control"
                                   placeholder="Ej. Coca-Cola"
                                   required
                                   autocomplete="off"
                                   data-sanitize="text"
                                   data-validate-input
                                   pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.Nombre"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label for="createProductPackaging"
                                   class="form-label">
                                Empaque *
                            </label>

                            <select asp-for="CreateProduct.IdEmpaque"
                                    id="createProductPackaging"
                                    class="form-select"
                                    required
                                    autocomplete="off"
                                    data-validate-input
                                    asp-items="@(Model.Packagings.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                            <span asp-validation-for="CreateProduct.IdEmpaque"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="createSalePrice"
                                   class="form-label">
                                Precio de venta(Bs) *
                            </label>

                            <input asp-for="CreateProduct.PrecioVenta"
                                   id="createSalePrice"
                                   class="form-control"
                                   placeholder="Ej. 12"
                                   inputmode="decimal"
                                   max="99999999.90"
                                   step="0.1"
                                   required
                                   autocomplete="off"
                                   data-validate-input
                                   data-gte-field="#createCostPrice"
                                   data-gte-message="El precio de venta no puede ser menor al precio de costo."
                                   value="" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.PrecioVenta"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="createCostPrice"
                                   class="form-label">
                                Precio de costo(Bs) *
                            </label>

                            <input asp-for="CreateProduct.PrecioCosto"
                                   id="createCostPrice"
                                   class="form-control"
                                   placeholder="Ej. 10,50"
                                   inputmode="decimal"
                                   max="99999999.90"
                                   step="0.1"
                                   required
                                   autocomplete="off"
                                   data-validate-input
                                   value="" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.PrecioCosto"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <label for="createMinStock"
                                   class="form-label">
                                Stock mínimo *
                            </label>

                            <input asp-for="CreateProduct.StockMinimo"
                                   id="createMinStock"
                                   class="form-control"
                                   placeholder="Ej. 5"       
                                   required
                                   autocomplete="off"
                                   data-validate-input
                                   pattern="^\d+$" 
                                   value="" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.StockMinimo"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <label for="createCategory"
                                   class="form-label">
                                Categoría *
                            </label>

                            <select asp-for="CreateProduct.IdCategoria"
                                    id="createCategory"
                                    class="form-select"
                                    required
                                    autocomplete="off"
                                    data-validate-input
                                    asp-items="@(Model.Categories.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                            <span asp-validation-for="CreateProduct.IdCategoria"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <label for="createSupplier"
                                   class="form-label">
                                Proveedor *
                            </label>

                            <select asp-for="CreateProduct.IdProveedor"
                                    id="createSupplier"
                                    class="form-select"
                                    required
                                    autocomplete="off"
                                    data-validate-input
                                    asp-items="@(Model.Suppliers.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                            <span asp-validation-for="CreateProduct.IdProveedor"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-save-button">
                        Guardar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


