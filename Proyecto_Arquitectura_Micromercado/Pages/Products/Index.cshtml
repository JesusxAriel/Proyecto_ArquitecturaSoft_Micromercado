<div class="modal fade"
     id="deleteProductModal"
     tabindex="-1"
     aria-labelledby="deleteProductLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Delete">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Pagina" />
                <input type="hidden" asp-for="Tamano" />
                <input type="hidden" asp-for="Q" />

                <div class="modal-header">

                    <h2 class="modal-title h5"
                        id="deleteProductLabel">
                        Eliminar producto
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           asp-for="DeleteProductId"
                           data-delete-id-input />

                    <p class="mb-0">
                        ¿Estás seguro que quieres eliminar
                        <strong data-delete-name-display></strong>?
                        Esta acción no se puede deshacer.
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Sí, eliminar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@if (Model.Products.Count == 0)
{
    <p class="text-muted">
        No hay productos activos registrados.
    </p>
}


@section Scripts {

    @if (Model.ShowCreateModal)
    {
        <script>
            bootstrap.Modal
                .getOrCreateInstance(
                    document.getElementById('createProductModal')
                )
                .show();
        </script>
    }

    @if (Model.ShowEditModal)
    {
        <script>
            bootstrap.Modal
                .getOrCreateInstance(
                    document.getElementById('editProductModal')
                )
                .show();
        </script>
    }


    <script>

        let initialSalePrice = null;
        let initialCostPrice = null;

        function resetFormValidation(form) {

            if (!form) {
                return;
            }

            form.classList.remove('was-validated');

            form.querySelectorAll(
                '.is-valid, .is-invalid'
            ).forEach(function(element) {

                element.classList.remove(
                    'is-valid',
                    'is-invalid'
                );

            });

            form.querySelectorAll(
                '.input-error'
            ).forEach(function(element) {

                element.classList.add('d-none');
                element.textContent = '';

            });

            form.querySelectorAll(
                'input, select, textarea'
            ).forEach(function(element) {

                element.setCustomValidity('');

            });

            form.querySelectorAll(
                '.modal-save-button, button[type="submit"]'
            ).forEach(function(button) {

                button.disabled = false;

            });

        }

        $('#createProductModal').on(
            'show.bs.modal',
            function() {

                const form =
                    document.getElementById(
                        'createProductForm'
                    );

                if (form) {
                    form.reset();
                }

                resetFormValidation(form);

            }
        );

        function normalizeReason(value) {

            const normalized =
                value
                    .trimStart()
                    .replace(/\s+/g, ' ');

            if (!normalized) {
                return '';
            }

            const firstLetterIndex =
                normalized.search(/\p{L}/u);

            if (firstLetterIndex < 0) {
                return normalized;
            }

            return normalized.slice(0, firstLetterIndex) +
                normalized
                    .charAt(firstLetterIndex)
                    .toLocaleUpperCase() +
                normalized.slice(firstLetterIndex + 1);

        }

        function validatePriceReason() {

            const input = $('#priceChangeReason');
            const error = $('#priceChangeReasonError');

            let value = normalizeReason(input.val().toString());

            input.val(value);

            const valid =
                value.length >= 3 &&
                !/[<>"'`;\\\u0000-\u001F\u007F]/.test(value);

            if (valid) {

                input
                    .removeClass('is-invalid')
                    .addClass('is-valid');

                error
                    .addClass('d-none')
                    .text('');

                return true;
            }

            input
                .removeClass('is-valid')
                .addClass('is-invalid');

            error
                .removeClass('d-none')
                .text(
                    value.length === 0
                        ? 'Debes ingresar una justificación para el cambio de precio.'
                        : 'Ingresa una justificación de al menos 3 caracteres.'
                );

            return false;
        }

        $('.edit-product-button').on('click', function() {

            const button = $(this);

            resetFormValidation(
                document.getElementById(
                    'editProductForm'
                )
            );


            $('#editProductId')
                .val(button.attr('data-id'));

            $('#editProductName')
                .val(button.attr('data-name'));

            $('#editProductPackaging')
                .val(button.attr('data-packaging'));

            $('#editSalePrice')
                .val(
                    (button.attr('data-sale-price') || '')
                        .replace('.', ',')
                );

            $('#editCostPrice')
                .val(
                    (button.attr('data-cost-price') || '')
                        .replace('.', ',')
                );

            $('#editMinStock')
                .val(button.attr('data-min-stock'));

            $('#editCategory')
                .val(
                    String(
                        button.attr('data-category')
                    )
                );

            $('#editSupplier')
                .val(
                    String(
                        button.attr('data-supplier')
                    )
                );


            $('#priceChangeReason')
                .val('');

            $('#PriceChangeReason')
                .val('');

            $('#editProductReason')
                .val('');

            $('#priceChangeReasonError')
                .addClass('d-none')
                .text('');

            $('#priceChangeReason')
                .removeClass('is-valid')
                .removeClass('is-invalid');

            $('#priceChangeReasonContainer')
                .addClass('d-none');

            initialSalePrice =
                Number(
                    (
                        button.attr(
                            'data-sale-price'
                        ) || ''
                    ).replace(',', '.')
                );

            initialCostPrice =
                Number(
                    (
                        button.attr(
                            'data-cost-price'
                        ) || ''
                    ).replace(',', '.')
                );

        });

        $('#editSalePrice, #editCostPrice')
            .on('input change', function() {

                const currentSalePrice =
                    Number(
                        ($('#editSalePrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );

                const currentCostPrice =
                    Number(
                        ($('#editCostPrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );


                const salePriceChanged =
                    currentSalePrice !== initialSalePrice;

                const costPriceChanged =
                    currentCostPrice !== initialCostPrice;


                if (
                    salePriceChanged ||
                    costPriceChanged
                ) {

                    $('#priceChangeReasonContainer')
                        .removeClass('d-none');

                }
                else {

                    $('#priceChangeReasonContainer')
                        .addClass('d-none');

                    $('#priceChangeReason')
                        .val('')
                        .removeClass('is-valid')
                        .removeClass('is-invalid');

                    $('#priceChangeReasonError')
                        .addClass('d-none')
                        .text('');

                    $('#PriceChangeReason')
                        .val('');

                    $('#editProductReason')
                        .val('');

                }

            });

        $('#priceChangeReason')
            .on('input', function() {

                validatePriceReason();

            });

        $('#editProductForm').on(
            'submit',
            function(event) {

                const currentSalePrice =
                    Number(
                        ($('#editSalePrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );

                const currentCostPrice =
                    Number(
                        ($('#editCostPrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );


                const salePriceChanged =
                    currentSalePrice !== initialSalePrice;

                const costPriceChanged =
                    currentCostPrice !== initialCostPrice;

                if (
                    !salePriceChanged &&
                    !costPriceChanged
                ) {

                    $('#PriceChangeReason')
                        .val('');

                    $('#editProductReason')
                        .val('');

                    return;

                }

                $('#priceChangeReasonContainer')
                    .removeClass('d-none');

                if (!validatePriceReason()) {

                    event.preventDefault();

                    $('#priceChangeReason')
                        .focus();

                    return;

                }

                const reason =
                    normalizeReason(
                        $('#priceChangeReason')
                            .val()
                            .toString()
                    );


                $('#priceChangeReason')
                    .val(reason);

                $('#PriceChangeReason')
                    .val(reason);

                $('#editProductReason')
                    .val(reason);

                // Sin preventDefault: el envío original continúa. No se debe volver a
                // llamar a requestSubmit() aquí, el navegador lo ignora mientras se
                // procesa el evento submit y obligaba a pulsar Guardar dos veces.

            }
        );

        $('#editProductModal')
            .on(
                'hidden.bs.modal',
                function() {

                    const form =
                        document.getElementById(
                            'editProductForm'
                        );


                    resetFormValidation(form);


                    $('#priceChangeReasonContainer')
                        .addClass('d-none');

                    $('#priceChangeReason')
                        .val('')
                        .removeClass('is-valid')
                        .removeClass('is-invalid');

                    $('#priceChangeReasonError')
                        .addClass('d-none')
                        .text('');

                    $('#PriceChangeReason')
                        .val('');

                    $('#editProductReason')
                        .val('');

                    initialSalePrice = null;
                    initialCostPrice = null;

                }
            );

        // La búsqueda y la paginación se resuelven en el servidor: se envía el
        // formulario GET poco después de dejar de escribir.
        (function() {

            const searchInput = document.getElementById('productSearch');
            let searchTimer = null;

            searchInput.addEventListener('input', function() {

                clearTimeout(searchTimer);

                searchTimer = setTimeout(function() {
                    searchInput.form.requestSubmit();
                }, 450);

            });

            if (new URLSearchParams(window.location.search).has('Q')) {

                searchInput.focus();

                searchInput.setSelectionRange(
                    searchInput.value.length,
                    searchInput.value.length
                );

            }

            document
                .getElementById('pageSizeSelect')
                .addEventListener('change', function() {
                    this.form.submit();
                });

        })();

        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function (alert) {
                var closeBtn = alert.querySelector('.btn-close');
                if (closeBtn) closeBtn.click();
            });
        }, 4000);

    </script>
}
