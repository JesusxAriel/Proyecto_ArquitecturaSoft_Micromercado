@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model Proyecto_Arquitectura_Micromercado.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="page-heading mb-0">Productos</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Products/History" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i>Historial
        </a>
        <button type="button" class="btn btn-warning fw-semibold px-3"
                data-bs-toggle="modal" data-bs-target="#createProductModal">
            <i class="bi bi-plus-lg me-1"></i>Añadir
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success shadow-sm" role="alert">@Model.StatusMessage</div>
}

<div class="mb-3">
    <label for="productSearch" class="visually-hidden">Buscar productos</label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input id="productSearch" class="form-control" type="search" placeholder="Buscar por nombre, categoría o proveedor..." autocomplete="off" />
    </div>
</div>

@if (Model.DatabaseWarning is not null)
{
    <div class="alert alert-warning shadow-sm" role="alert">@Model.DatabaseWarning</div>
}

<div class="table-responsive shadow-sm rounded-3">
<table id="productsTable" class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Presentación</th>
            <th>Categoría</th>
            <th>Proveedor</th>
            <th class="text-center">Precio</th>
            <th class="text-center" style="min-width: 120px;">Stock mínimo</th>
            <th class="text-end pe-3">ACCIONES</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Nombre</td>
            <td>@product.EmpaquePresentacion</td>
            <td>@product.NombreCategoria</td>
            <td>@product.NombreProveedor</td>
            <td class="text-center">Bs. @product.PrecioVenta.ToString("N2")</td>
            <td class="text-center" style="min-width: 120px;">@product.StockMinimo</td>
            <td class="text-end pe-3">
                <div class="d-flex justify-content-end align-items-center gap-1">
                    <button type="button" class="btn btn-sm btn-outline-warning edit-product-button" title="Editar" aria-label="Editar @product.Nombre"
                            data-bs-toggle="modal" data-bs-target="#editProductModal"
                            data-id="@product.Id" data-name="@product.Nombre" data-packaging="@product.EmpaquePresentacion"
                            data-sale-price="@product.PrecioVenta.ToString("0.00")"
                            data-cost-price="@product.PrecioCosto.ToString("0.00")"
                            data-min-stock="@product.StockMinimo" data-category="@product.IdCategoria" data-supplier="@product.IdProveedor">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger delete-product-button" title="Eliminar" aria-label="Eliminar @product.Nombre"
                            data-bs-toggle="modal" data-bs-target="#deleteProductModal" data-id="@product.Id" data-name="@product.Nombre">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create" id="createProductForm" class="modal-form" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="createProductLabel">Nuevo producto</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="createProductName" class="form-label">Nombre *</label>
                            <input asp-for="CreateProduct.Nombre" id="createProductName" class="form-control" required data-sanitize="text" data-validate-input pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />
                            <div class="input-error text-danger small d-none"></div>
                            <span asp-validation-for="CreateProduct.Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label for="createProductPackaging" class="form-label">Presentación *</label>
                            <input asp-for="CreateProduct.EmpaquePresentacion" id="createProductPackaging" class="form-control" required data-sanitize="text" data-validate-input pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />
                            <div class="input-error text-danger small d-none"></div>
                            <span asp-validation-for="CreateProduct.EmpaquePresentacion" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label for="createSalePrice" class="form-label">Precio de venta *</label>
                            <input asp-for="CreateProduct.PrecioVenta" id="createSalePrice" class="form-control" inputmode="decimal" max="99999999.90" step="0.1" required data-validate-input />
                            <div class="input-error text-danger small d-none"></div>
                            <span asp-validation-for="CreateProduct.PrecioVenta" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label for="createCostPrice" class="form-label">Precio de costo *</label>
                            <input asp-for="CreateProduct.PrecioCosto" id="createCostPrice" class="form-control" inputmode="decimal" max="99999999.90" step="0.1" required data-validate-input />
                            <div class="input-error text-danger small d-none"></div>
                            <span asp-validation-for="CreateProduct.PrecioCosto" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label for="createMinStock" class="form-label">Stock mínimo *</label>
                            <input asp-for="CreateProduct.StockMinimo" id="createMinStock" class="form-control" required data-validate-input pattern="^\d+$" />
                            <div class="input-error text-danger small d-none"></div>
                            <span asp-validation-for="CreateProduct.StockMinimo" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label for="createCategory" class="form-label">Categoría *</label>
                            <select asp-for="CreateProduct.IdCategoria" id="createCategory" class="form-select" required data-validate-input asp-items="@(Model.Categories.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">
                                <option value="0">Seleccione...</option>
                            </select>
                            <span asp-validation-for="CreateProduct.IdCategoria" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label for="createSupplier" class="form-label">Proveedor *</label>
                            <select asp-for="CreateProduct.IdProveedor" id="createSupplier" class="form-select" required data-validate-input asp-items="@(Model.Suppliers.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">
                                <option value="0">Seleccione...</option>
                            </select>
                            <span asp-validation-for="CreateProduct.IdProveedor" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary modal-save-button">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit" id="editProductForm" class="modal-form" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="editProductLabel">Editar producto</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditProduct.Id" id="editProductId" />
                    <input type="hidden" asp-for="EditProduct.MotivoCambio" id="editProductReason" />
                    <input type="hidden" id="PriceChangeReason" name="PriceChangeReason" />
                    <span asp-validation-for="PriceChangeReason" class="text-danger"></span>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="editProductName" class="form-label">Nombre *</label>
                            <input asp-for="EditProduct.Nombre" id="editProductName" class="form-control" required data-sanitize="text" data-validate-input pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />
                            <div class="input-error text-danger small d-none"></div>
                        </div>
                        <div class="col-md-4">
                            <label for="editProductPackaging" class="form-label">Presentación *</label>
                            <input asp-for="EditProduct.EmpaquePresentacion" id="editProductPackaging" class="form-control" required data-sanitize="text" data-validate-input pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />
                            <div class="input-error text-danger small d-none"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="editSalePrice" class="form-label">Precio de venta *</label>
                            <input asp-for="EditProduct.PrecioVenta" id="editSalePrice" class="form-control" inputmode="decimal" required data-validate-input />
                            <div class="input-error text-danger small d-none"></div>
                        </div>
                        <div class="col-md-3">
                            <label for="editCostPrice" class="form-label">Precio de costo *</label>
                            <input asp-for="EditProduct.PrecioCosto" id="editCostPrice" class="form-control" inputmode="decimal" required data-validate-input />
                            <div class="input-error text-danger small d-none"></div>
                        </div>
                        <div class="col-md-2">
                            <label for="editMinStock" class="form-label">Stock mínimo *</label>
                            <input asp-for="EditProduct.StockMinimo" id="editMinStock" class="form-control" required data-validate-input pattern="^\d+$" />
                            <div class="input-error text-danger small d-none"></div>
                        </div>
                        <div class="col-md-2">
                            <label for="editCategory" class="form-label">Categoría *</label>
                            <select asp-for="EditProduct.IdCategoria" id="editCategory" class="form-select" required data-validate-input asp-items="@(Model.Categories.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))"></select>
                        </div>
                        <div class="col-md-2">
                            <label for="editSupplier" class="form-label">Proveedor *</label>
                            <select asp-for="EditProduct.IdProveedor" id="editSupplier" class="form-select" required data-validate-input asp-items="@(Model.Suppliers.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))"></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary modal-save-button">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="priceChangeReasonModal" tabindex="-1" aria-labelledby="priceChangeReasonLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="priceChangeReasonLabel">Justificación del cambio de precio</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Indica por qué se modificó el precio de venta o costo.</p>
                <label for="priceChangeReason" class="form-label">Motivo del cambio</label>
                <input id="priceChangeReason" class="form-control" type="text" maxlength="255"
                       autocomplete="off" required minlength="3" />
                <div id="priceChangeReasonError" class="text-danger small d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmPriceChangeReason" class="btn btn-primary" disabled>
                    Continuar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Delete">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteProductLabel">Eliminar producto</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="DeleteProductId" data-delete-id-input />
                    <p class="mb-0">¿Estás seguro de que querés eliminar <strong data-delete-name-display></strong>? Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Products.Count == 0)
{
    <p class="text-muted">No hay productos activos registrados.</p>
}

@section Scripts {
    @if (Model.ShowCreateModal)
    {
        <script>bootstrap.Modal.getOrCreateInstance(document.getElementById('createProductModal')).show();</script>
    }
    @if (Model.ShowEditModal)
    {
        <script>bootstrap.Modal.getOrCreateInstance(document.getElementById('editProductModal')).show();</script>
    }
    <script>
        let reasonConfirmed = false;
        let initialSalePrice = null;
        let initialCostPrice = null;

        $('.edit-product-button').on('click', function () {
            const button = $(this);
            reasonConfirmed = false;
            $('#editProductId').val(button.attr('data-id'));
            $('#editProductName').val(button.attr('data-name'));
            $('#editProductPackaging').val(button.attr('data-packaging'));
            $('#editSalePrice').val((button.attr('data-sale-price') || '').replace('.', ','));
            $('#editCostPrice').val((button.attr('data-cost-price') || '').replace('.', ','));
            $('#editMinStock').val(button.attr('data-min-stock'));
            $('#editCategory').val(String(button.attr('data-category')));
            $('#editSupplier').val(String(button.attr('data-supplier')));
            $('#editProductReason').val('');
            initialSalePrice = Number((button.attr('data-sale-price') || '').replace(',', '.'));
            initialCostPrice = Number((button.attr('data-cost-price') || '').replace(',', '.'));
            $('#editProductForm').find('[data-validate-input]').trigger('input');
        });

        $('#editProductForm').on('submit', function (event) {
            if (reasonConfirmed) {
                reasonConfirmed = false;
                return;
            }

            const salePriceChanged = Number($('#editSalePrice').val().replace(',', '.')) !== initialSalePrice;
            const costPriceChanged = Number($('#editCostPrice').val().replace(',', '.')) !== initialCostPrice;

            if (salePriceChanged || costPriceChanged) {
                event.preventDefault();
                $('#priceChangeReason').val('');
                $('#priceChangeReasonError').addClass('d-none').text('');
                $('#confirmPriceChangeReason').prop('disabled', true);
                bootstrap.Modal.getOrCreateInstance(document.getElementById('priceChangeReasonModal')).show();
            }
        });

        function normalizeReason(value) {
            const normalized = value.trimStart().replace(/\s+/g, ' ');
            const firstLetterIndex = normalized.search(/\p{L}/u);
            if (firstLetterIndex < 0) {
                return normalized;
            }

            return normalized.slice(0, firstLetterIndex) +
                normalized.charAt(firstLetterIndex).toLocaleUpperCase() +
                normalized.slice(firstLetterIndex + 1);
        }

        function validatePriceReason() {
            const input = $('#priceChangeReason');
            let value = normalizeReason(input.val().toString());
            input.val(value);
            const valid = value.length >= 3 &&
                !/[<>"'`;\\\u0000-\u001F\u007F]/.test(value);
            $('#confirmPriceChangeReason').prop('disabled', !valid);
            $('#priceChangeReasonError').toggleClass('d-none', valid).text(
                valid ? '' : 'Ingresa una justificación de al menos 3 caracteres.');
            return valid;
        }

        $('#priceChangeReason').on('input blur', validatePriceReason);
        $('#confirmPriceChangeReason').on('click', function () {
            if (!validatePriceReason()) {
                return;
            }

            const reason = normalizeReason($('#priceChangeReason').val().toString());
            $('#PriceChangeReason').val(reason);
            $('#editProductReason').val(reason);
            reasonConfirmed = true;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('priceChangeReasonModal')).hide();
            document.getElementById('editProductForm').requestSubmit();
        });

        $('#productSearch').on('input', function () {
            const query = $(this).val().toString().toLocaleLowerCase();
            $('#productsTable tbody tr').each(function () {
                $(this).toggle($(this).text().toLocaleLowerCase().includes(query));
            });
        });
    </script>
}
