@page
@using Microsoft.AspNetCore.Mvc.Rendering
@model Proyecto_Arquitectura_Micromercado.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="page-heading mb-0">Productos</h1>

    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Products/History" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history me-1"></i>Historial
        </a>

        <button type="button"
                class="btn btn-warning fw-semibold px-3"
                data-bs-toggle="modal"
                data-bs-target="#createProductModal">
            <i class="bi bi-plus-lg me-1"></i>Añadir
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success shadow-sm" role="alert">
        @Model.StatusMessage
    </div>
}

<div class="mb-3">
    <label for="productSearch" class="visually-hidden">
        Buscar productos
    </label>

    <div class="input-group">
        <span class="input-group-text">
            <i class="bi bi-search" aria-hidden="true"></i>
        </span>

        <input id="productSearch"
               class="form-control"
               type="search"
               placeholder="Buscar por nombre, categoría o proveedor..."
               autocomplete="off" />
    </div>
</div>

@if (Model.DatabaseWarning is not null)
{
    <div class="alert alert-warning shadow-sm" role="alert">
        @Model.DatabaseWarning
    </div>
}

<div class="table-responsive shadow-sm rounded-3">
    <table id="productsTable" class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Presentación</th>
                <th>Categoría</th>
                <th>Proveedor</th>
                <th class="text-center">Precio(Bs)</th>
                <th class="text-center" style="min-width: 120px;">Stock mínimo</th>
                <th class="text-end pe-3">ACCIONES</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Nombre</td>
                    <td>@product.EmpaquePresentacion</td>
                    <td>@product.NombreCategoria</td>
                    <td>@product.NombreProveedor</td>

                    <td class="text-center">
                        Bs. @product.PrecioVenta.ToString("N2")
                    </td>

                    <td class="text-center" style="min-width: 120px;">
                        @product.StockMinimo
                    </td>

                    <td class="text-end pe-3">
                        <div class="d-flex justify-content-end align-items-center gap-1">

                            <button type="button"
                                    class="btn btn-sm btn-outline-warning edit-product-button"
                                    title="Editar"
                                    aria-label="Editar @product.Nombre"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editProductModal"
                                    data-id="@product.Id"
                                    data-name="@product.Nombre"
                                    data-packaging="@product.EmpaquePresentacion"
                                    data-sale-price="@product.PrecioVenta.ToString("0.00")"
                                    data-cost-price="@product.PrecioCosto.ToString("0.00")"
                                    data-min-stock="@product.StockMinimo"
                                    data-category="@product.IdCategoria"
                                    data-supplier="@product.IdProveedor">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger delete-product-button"
                                    title="Eliminar"
                                    aria-label="Eliminar @product.Nombre"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteProductModal"
                                    data-id="@product.Id"
                                    data-name="@product.Nombre">
                                <i class="bi bi-trash"></i>
                            </button>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<!-- ========================================================= -->
<!-- MODAL CREAR PRODUCTO                                      -->
<!-- ========================================================= -->

<div class="modal fade"
     id="createProductModal"
     tabindex="-1"
     aria-labelledby="createProductLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Create"
                  id="createProductForm"
                  class="modal-form"
                  novalidate
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h2 class="modal-title h5" id="createProductLabel">
                        Nuevo producto
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-8">

                            <label for="createProductName"
                                   class="form-label">
                                Nombre *
                            </label>

                            <input asp-for="CreateProduct.Nombre"
                                   id="createProductName"
                                   class="form-control"
                                   placeholder="Ej. Coca-Cola"
                                   required
                                   autocomplete="off"
                                   data-sanitize="text"
                                   data-validate-input
                                   pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.Nombre"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4">

                            <label for="createProductPackaging"
                                   class="form-label">
                                Empaque *
                            </label>

                            <input asp-for="CreateProduct.EmpaquePresentacion"
                                   id="createProductPackaging"
                                   class="form-control"
                                   placeholder="Ej. Bolsa"
                                   required
                                   autocomplete="off"
                                   data-sanitize="text"
                                   data-validate-input
                                   pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.EmpaquePresentacion"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="createSalePrice"
                                   class="form-label">
                                Precio de venta(Bs) *
                            </label>

                            <input asp-for="CreateProduct.PrecioVenta"
                                   id="createSalePrice"
                                   class="form-control"
                                   placeholder="Ej. 12"
                                   inputmode="decimal"
                                   max="99999999.90"
                                   step="0.1"
                                   required
                                   autocomplete="off"
                                   data-validate-input
                                   value="" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.PrecioVenta"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-3">

                            <label for="createCostPrice"
                                   class="form-label">
                                Precio de costo(Bs) *
                            </label>

                            <input asp-for="CreateProduct.PrecioCosto"
                                   id="createCostPrice"
                                   class="form-control"
                                   placeholder="Ej. 10,50"
                                   inputmode="decimal"
                                   max="99999999.90"
                                   step="0.1"
                                   required
                                   autocomplete="off"
                                   data-validate-input
                                   value="" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.PrecioCosto"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <label for="createMinStock"
                                   class="form-label">
                                Stock mínimo *
                            </label>

                            <input asp-for="CreateProduct.StockMinimo"
                                   id="createMinStock"
                                   class="form-control"
                                   placeholder="Ej. 5"       
                                   required
                                   autocomplete="off"
                                   data-validate-input
                                   pattern="^\d+$" 
                                   value="" />

                            <div class="input-error text-danger small d-none"></div>

                            <span asp-validation-for="CreateProduct.StockMinimo"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <label for="createCategory"
                                   class="form-label">
                                Categoría *
                            </label>

                            <select asp-for="CreateProduct.IdCategoria"
                                    id="createCategory"
                                    class="form-select"
                                    required
                                    autocomplete="off"
                                    data-validate-input
                                    asp-items="@(Model.Categories.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                            <span asp-validation-for="CreateProduct.IdCategoria"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-2">

                            <label for="createSupplier"
                                   class="form-label">
                                Proveedor *
                            </label>

                            <select asp-for="CreateProduct.IdProveedor"
                                    id="createSupplier"
                                    class="form-select"
                                    required
                                    autocomplete="off"
                                    data-validate-input
                                    asp-items="@(Model.Suppliers.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">

                                <option value="">
                                    Seleccione...
                                </option>

                            </select>

                            <span asp-validation-for="CreateProduct.IdProveedor"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-save-button">
                        Guardar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- MODAL EDITAR PRODUCTO                                    -->
<!-- ========================================================= -->

<div class="modal fade"
     id="editProductModal"
     tabindex="-1"
     aria-labelledby="editProductLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Edit"
                  id="editProductForm"
                  class="modal-form"
                  novalidate
                  autocomplete="off">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h2 class="modal-title h5"
                        id="editProductLabel">
                        Editar producto
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           asp-for="EditProduct.Id"
                           id="editProductId" />

                    <input type="hidden"
                           asp-for="EditProduct.MotivoCambio"
                           id="editProductReason" />

                    <input type="hidden"
                           id="PriceChangeReason"
                           name="PriceChangeReason" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-8">

                            <label for="editProductName"
                                   class="form-label">
                                Nombre *
                            </label>

                            <input asp-for="EditProduct.Nombre"
                                   id="editProductName"
                                   class="form-control"
                                   placeholder="Ej. Coca-Cola"
                                   required
                                   autocomplete="off"
                                   data-sanitize="text"
                                   data-validate-input
                                   pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />

                            <div class="input-error text-danger small d-none"></div>

                        </div>

                        <div class="col-md-4">

                            <label for="editProductPackaging"
                                   class="form-label">
                                Empaque *
                            </label>

                            <input asp-for="EditProduct.EmpaquePresentacion"
                                   id="editProductPackaging"
                                   class="form-control"
                                   placeholder="Ej. Bolsa"
                                   required
                                   autocomplete="off"                        
                                   data-sanitize="text"
                                   data-validate-input
                                   pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\,\-]+$" />

                            <div class="input-error text-danger small d-none"></div>

                        </div>

                        <div class="col-md-3">

                            <label for="editSalePrice"
                                   class="form-label">
                                Precio de venta(Bs) *
                            </label>

                            <input asp-for="EditProduct.PrecioVenta"
                                   id="editSalePrice"
                                   class="form-control"
                                   placeholder="Ej. 12"
                                   inputmode="decimal"
                                   required
                                   data-validate-input
                                   autocomplete="off" />

                            <div class="input-error text-danger small d-none"></div>

                        </div>

                        <div class="col-md-3">

                            <label for="editCostPrice"
                                   class="form-label">
                                Precio de costo(Bs) *
                            </label>

                            <input asp-for="EditProduct.PrecioCosto"
                                   id="editCostPrice"
                                   class="form-control"
                                   placeholder="Ej. 10,50"
                                   inputmode="decimal"
                                   required
                                   data-validate-input
                                   autocomplete="off" />

                            <div class="input-error text-danger small d-none"></div>

                        </div>

                        <div class="col-md-2">

                            <label for="editMinStock"
                                   class="form-label">
                                Stock mínimo *
                            </label>

                            <input asp-for="EditProduct.StockMinimo"
                                   id="editMinStock"
                                   class="form-control"
                                   placeholder="Ej. 5"
                                   required
                                   data-validate-input
                                   pattern="^\d+$"
                                   autocomplete="off" />

                            <div class="input-error text-danger small d-none"></div>

                        </div>

                        <div class="col-md-2">

                            <label for="editCategory"
                                   class="form-label">
                                Categoría *
                            </label>

                            <select asp-for="EditProduct.IdCategoria"
                                    id="editCategory"
                                    class="form-select"
                                    required
                                    data-validate-input
                                    autocomplete="off"
                                    asp-items="@(Model.Categories.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">
                            </select>

                        </div>

                        <div class="col-md-2">

                            <label for="editSupplier"
                                   class="form-label">
                                Proveedor *
                            </label>

                            <select asp-for="EditProduct.IdProveedor"
                                    id="editSupplier"
                                    class="form-select"
                                    required
                                    data-validate-input
                                    autocomplete="off"
                                    asp-items="@(Model.Suppliers.Select(x => new SelectListItem(x.Nombre, x.Id.ToString())))">
                            </select>

                        </div>


                        <!-- ================================================= -->
                        <!-- JUSTIFICACIÓN                                     -->
                        <!-- ================================================= -->

                        <div id="priceChangeReasonContainer"
                             class="col-12 d-none">

                            <div class="alert alert-warning mb-0">

                                <div class="fw-semibold mb-2">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    Justificación del cambio de precio
                                </div>

                                <p class="small text-muted mb-3">
                                    Has modificado el precio de venta o el precio
                                    de costo. Debes indicar el motivo del cambio.
                                </p>

                                <label for="priceChangeReason"
                                       class="form-label">
                                    Motivo del cambio *
                                </label>

                                <input id="priceChangeReason"
                                       class="form-control"
                                       placeholder="Ej. Ajuste de precio por proveedor"
                                       type="text"
                                       maxlength="255"
                                       autocomplete="off" />

                                <div id="priceChangeReasonError"
                                     class="text-danger small mt-1 d-none">
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-save-button">
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- MODAL ELIMINAR PRODUCTO                                  -->
<!-- ========================================================= -->

<div class="modal fade"
     id="deleteProductModal"
     tabindex="-1"
     aria-labelledby="deleteProductLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form method="post"
                  asp-page-handler="Delete">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h2 class="modal-title h5"
                        id="deleteProductLabel">
                        Eliminar producto
                    </h2>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           asp-for="DeleteProductId"
                           data-delete-id-input />

                    <p class="mb-0">
                        ¿Estás seguro que quieres eliminar
                        <strong data-delete-name-display></strong>?
                        Esta acción no se puede deshacer.
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>
                        Sí, eliminar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@if (Model.Products.Count == 0)
{
    <p class="text-muted">
        No hay productos activos registrados.
    </p>
}


@section Scripts {

    @if (Model.ShowCreateModal)
    {
        <script>
            bootstrap.Modal
                .getOrCreateInstance(
                    document.getElementById('createProductModal')
                )
                .show();
        </script>
    }

    @if (Model.ShowEditModal)
    {
        <script>
            bootstrap.Modal
                .getOrCreateInstance(
                    document.getElementById('editProductModal')
                )
                .show();
        </script>
    }


    <script>

        let reasonConfirmed = false;

        let initialSalePrice = null;
        let initialCostPrice = null;


        /*
         * ==========================================================
         * LIMPIAR VALIDACIÓN VISUAL
         * ==========================================================
         */

        function resetFormValidation(form) {

            if (!form) {
                return;
            }

            form.classList.remove('was-validated');

            form.querySelectorAll(
                '.is-valid, .is-invalid'
            ).forEach(function(element) {

                element.classList.remove(
                    'is-valid',
                    'is-invalid'
                );

            });

            form.querySelectorAll(
                '.input-error'
            ).forEach(function(element) {

                element.classList.add('d-none');
                element.textContent = '';

            });

            form.querySelectorAll(
                'input, select, textarea'
            ).forEach(function(element) {

                element.setCustomValidity('');

            });

        }


        /*
         * ==========================================================
         * NORMALIZAR MOTIVO
         * ==========================================================
         */

        function normalizeReason(value) {

            const normalized =
                value
                    .trimStart()
                    .replace(/\s+/g, ' ');

            if (!normalized) {
                return '';
            }

            const firstLetterIndex =
                normalized.search(/\p{L}/u);

            if (firstLetterIndex < 0) {
                return normalized;
            }

            return normalized.slice(0, firstLetterIndex) +
                normalized
                    .charAt(firstLetterIndex)
                    .toLocaleUpperCase() +
                normalized.slice(firstLetterIndex + 1);

        }


        /*
         * ==========================================================
         * VALIDAR MOTIVO
         * ==========================================================
         */

        function validatePriceReason() {

            const input =
                $('#priceChangeReason');

            const error =
                $('#priceChangeReasonError');

            let value =
                normalizeReason(
                    input.val().toString()
                );

            input.val(value);

            const valid =
                value.length >= 3 &&
                !/[<>"'`;\\\u0000-\u001F\u007F]/.test(value);


            if (valid) {

                error
                    .addClass('d-none')
                    .text('');

                input
                    .removeClass('is-invalid')
                    .removeClass('is-valid');

                return true;
            }

            input
                .removeClass('is-valid')
                .addClass('is-invalid');

            error
                .removeClass('d-none')
                .text(
                    value.length === 0
                        ? 'Debes ingresar una justificación para el cambio de precio.'
                        : 'Ingresa una justificación de al menos 3 caracteres.'
                );

            return false;
        }


        /*
         * ==========================================================
         * ABRIR PRODUCTO PARA EDITAR
         * ==========================================================
         */

        $('.edit-product-button').on('click', function() {

            const button = $(this);

            reasonConfirmed = false;

            resetFormValidation(
                document.getElementById(
                    'editProductForm'
                )
            );


            $('#editProductId')
                .val(button.attr('data-id'));

            $('#editProductName')
                .val(button.attr('data-name'));

            $('#editProductPackaging')
                .val(button.attr('data-packaging'));

            $('#editSalePrice')
                .val(
                    (button.attr('data-sale-price') || '')
                        .replace('.', ',')
                );

            $('#editCostPrice')
                .val(
                    (button.attr('data-cost-price') || '')
                        .replace('.', ',')
                );

            $('#editMinStock')
                .val(button.attr('data-min-stock'));

            $('#editCategory')
                .val(
                    String(
                        button.attr('data-category')
                    )
                );

            $('#editSupplier')
                .val(
                    String(
                        button.attr('data-supplier')
                    )
                );


            $('#priceChangeReason')
                .val('');

            $('#PriceChangeReason')
                .val('');

            $('#editProductReason')
                .val('');

            $('#priceChangeReasonError')
                .addClass('d-none')
                .text('');

            $('#priceChangeReason')
                .removeClass('is-valid')
                .removeClass('is-invalid');

            $('#priceChangeReasonContainer')
                .addClass('d-none');

            initialSalePrice =
                Number(
                    (
                        button.attr(
                            'data-sale-price'
                        ) || ''
                    ).replace(',', '.')
                );

            initialCostPrice =
                Number(
                    (
                        button.attr(
                            'data-cost-price'
                        ) || ''
                    ).replace(',', '.')
                );

        });


        /*
         * ==========================================================
         * DETECTAR CAMBIOS DE PRECIO
         * ==========================================================
         */

        $('#editSalePrice, #editCostPrice')
            .on('input change', function() {

                const currentSalePrice =
                    Number(
                        ($('#editSalePrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );

                const currentCostPrice =
                    Number(
                        ($('#editCostPrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );


                const salePriceChanged =
                    currentSalePrice !== initialSalePrice;

                const costPriceChanged =
                    currentCostPrice !== initialCostPrice;


                if (
                    salePriceChanged ||
                    costPriceChanged
                ) {

                    $('#priceChangeReasonContainer')
                        .removeClass('d-none');

                }
                else {

                    $('#priceChangeReasonContainer')
                        .addClass('d-none');

                    $('#priceChangeReason')
                        .val('')
                        .removeClass('is-valid')
                        .removeClass('is-invalid');

                    $('#priceChangeReasonError')
                        .addClass('d-none')
                        .text('');

                    $('#PriceChangeReason')
                        .val('');

                    $('#editProductReason')
                        .val('');

                }

            });


        /*
         * ==========================================================
         * VALIDAR MOTIVO MIENTRAS SE ESCRIBE
         * ==========================================================
         */

        $('#priceChangeReason')
            .on('input', function() {

                validatePriceReason();

            });


        /*
         * ==========================================================
         * SUBMIT DEL FORMULARIO DE EDICIÓN
         * ==========================================================
         */

        $('#editProductForm').on(
            'submit',
            function(event) {

                if (reasonConfirmed) {

                    reasonConfirmed = false;

                    return;

                }

                const currentSalePrice =
                    Number(
                        ($('#editSalePrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );

                const currentCostPrice =
                    Number(
                        ($('#editCostPrice').val() || '')
                            .toString()
                            .replace(',', '.')
                    );


                const salePriceChanged =
                    currentSalePrice !== initialSalePrice;

                const costPriceChanged =
                    currentCostPrice !== initialCostPrice;


                /*
                 * ==================================================
                 * SI NO CAMBIÓ NINGÚN PRECIO
                 * ==================================================
                 */

                if (
                    !salePriceChanged &&
                    !costPriceChanged
                ) {

                    $('#PriceChangeReason')
                        .val('');

                    $('#editProductReason')
                        .val('');

                    return;

                }


                /*
                 * ==================================================
                 * CAMBIÓ EL PRECIO
                 * ==================================================
                 */

                event.preventDefault();

                $('#priceChangeReasonContainer')
                    .removeClass('d-none');

                if (!validatePriceReason()) {

                    $('#priceChangeReason')
                        .focus();

                    return;

                }

                const reason =
                    normalizeReason(
                        $('#priceChangeReason')
                            .val()
                            .toString()
                    );


                $('#priceChangeReason')
                    .val(reason);

                $('#PriceChangeReason')
                    .val(reason);

                $('#editProductReason')
                    .val(reason);

                reasonConfirmed = true;

                document
                    .getElementById(
                        'editProductForm'
                    )
                    .requestSubmit();

            }
        );


        /*
         * ==========================================================
         * CUANDO SE CIERRA EL MODAL DE EDITAR
         * ==========================================================
         */

        $('#editProductModal')
            .on(
                'hidden.bs.modal',
                function() {

                    const form =
                        document.getElementById(
                            'editProductForm'
                        );


                    resetFormValidation(form);


                    $('#priceChangeReasonContainer')
                        .addClass('d-none');

                    $('#priceChangeReason')
                        .val('')
                        .removeClass('is-valid')
                        .removeClass('is-invalid');

                    $('#priceChangeReasonError')
                        .addClass('d-none')
                        .text('');

                    $('#PriceChangeReason')
                        .val('');

                    $('#editProductReason')
                        .val('');

                    reasonConfirmed = false;

                    initialSalePrice = null;
                    initialCostPrice = null;

                }
            );


        /*
         * ==========================================================
         * BUSCADOR DE PRODUCTOS
         * ==========================================================
         */

        $('#productSearch').on(
            'input',
            function() {

                const query =
                    $(this)
                        .val()
                        .toString()
                        .toLocaleLowerCase();


                $('#productsTable tbody tr')
                    .each(function() {

                        $(this).toggle(
                            $(this)
                                .text()
                                .toLocaleLowerCase()
                                .includes(query)
                        );

                    });

            }
        );

    </script>
}
