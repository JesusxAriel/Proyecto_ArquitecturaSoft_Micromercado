@page
@model Proyecto_Arquitectura_Micromercado.Pages.Products.HistoryModel
@{
    ViewData["Title"] = "Historial de Precios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-heading mb-0">Historial de Precios</h1>
    <a asp-page="/Products/Index" class="btn btn-outline-primary">
        <i class="bi bi-box-seam me-1"></i>Volver a Productos
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="sticky-table-header">
            <tr>
                <th>Producto</th>
                <th>Precio Venta Ant. <span class="th-unit">(Bs)</span></th>
                <th>Precio Venta Nuevo <span class="th-unit">(Bs)</span></th>
                <th>Precio Costo Ant. <span class="th-unit">(Bs)</span></th>
                <th>Precio Costo Nuevo <span class="th-unit">(Bs)</span></th>
                <th>Motivo de Cambio</th>
                <th>Usuario</th>
                <th>Fecha de Cambio</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var change in Model.PriceHistory)
        {
            <tr>
                <td>@change.NombreProducto</td>
                <td>@change.PrecioVentaAnterior.ToString("N2")</td>
                <td>@change.PrecioVentaNuevo.ToString("N2")</td>
                <td>
                    @(change.PrecioCostoAnterior.HasValue
                        ? change.PrecioCostoAnterior.Value.ToString("N2")
                        : "—")
                </td>
                <td>
                    @(change.PrecioCostoNuevo.HasValue
                        ? change.PrecioCostoNuevo.Value.ToString("N2")
                        : "—")
                </td>
                <td>@change.MotivoCambio</td>
                <td>@change.IdUsuario</td>
                <td>@change.FechaCambio.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.PriceHistory.Count == 0)
{
    <p class="text-muted">No hay cambios de precios registrados.</p>
}
