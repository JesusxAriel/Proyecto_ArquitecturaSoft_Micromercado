@page
@model Proyecto_Arquitectura_Micromercado.Pages.Products.HistoryModel
@{
    ViewData["Title"] = "Historial de Precios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-heading mb-0">Historial de Precios</h1>
        @if (Model.IsProductHistory)
        {
            <p class="text-muted mb-0">Producto: @Model.ProductName</p>
        }
    </div>
    <a asp-page="/Products/Index" class="btn btn-outline-primary">
        <i class="bi bi-box-seam me-1"></i>Volver a Productos
    </a>
</div>

<form method="get" asp-page="/Products/History" class="row g-2 align-items-end mb-4">
    <div class="col-md-6 col-lg-4">
        <label for="productHistoryId" class="form-label">Consultar historial de precios</label>
        <select id="productHistoryId" name="id" class="form-select" onchange="this.form.submit()">
            <option value="" selected="@(Model.ProductId is null)">Todos los productos</option>
            @foreach (var product in Model.Products)
            {
                <option value="@product.Id" selected="@(Model.ProductId == product.Id)">
                    @product.Nombre
                </option>
            }
        </select>
    </div>
    <noscript>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Consultar</button>
        </div>
    </noscript>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="sticky-table-header">
            <tr>
                <th>Producto</th>
                <th>Precio Venta Ant. <span class="th-unit">(Bs)</span></th>
                <th>Precio Venta Nuevo <span class="th-unit">(Bs)</span></th>
                <th>Precio Costo Ant. <span class="th-unit">(Bs)</span></th>
                <th>Precio Costo Nuevo <span class="th-unit">(Bs)</span></th>
                <th>Motivo de Cambio</th>
                <th>Usuario</th>
                <th>Fecha de Cambio</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var change in Model.PriceHistory)
        {
            <tr>
                <td>@change.NombreProducto</td>
                <td>@change.PrecioVentaAnterior.ToString("N2")</td>
                <td>@change.PrecioVentaNuevo.ToString("N2")</td>
                <td>
                    @(change.PrecioCostoAnterior.HasValue
                        ? change.PrecioCostoAnterior.Value.ToString("N2")
                        : "—")
                </td>
                <td>
                    @(change.PrecioCostoNuevo.HasValue
                        ? change.PrecioCostoNuevo.Value.ToString("N2")
                        : "—")
                </td>
                <td>@change.MotivoCambio</td>
                <td>@change.IdUsuario</td>
                <td>@change.FechaCambio.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#priceHistoryDetailModal"
                            data-detail-url="@Url.Page("/Products/History", "Detalle", new { id = change.Id })">
                        Ver detalle
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="priceHistoryDetailModal" tabindex="-1" aria-labelledby="priceHistoryDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="priceHistoryDetailContent">
            <div class="modal-header">
                <h2 class="modal-title h5" id="priceHistoryDetailTitle">Detalle de la transacción</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" aria-live="polite">
                <p class="text-muted mb-0">Seleccione un registro para consultar sus datos.</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('priceHistoryDetailModal');
        const content = document.getElementById('priceHistoryDetailContent');

        modal.addEventListener('show.bs.modal', async event => {
            const trigger = event.relatedTarget;
            const detailUrl = trigger?.getAttribute('data-detail-url');
            const body = content.querySelector('.modal-body');

            if (!detailUrl) {
                body.textContent = 'No se pudo identificar el registro seleccionado.';
                return;
            }

            body.textContent = 'Cargando detalle…';

            try {
                const response = await fetch(detailUrl, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (response.status === 404) {
                    body.textContent = 'El registro histórico ya no existe.';
                    return;
                }

                if (!response.ok) {
                    body.textContent = 'No se pudo cargar el detalle de la transacción.';
                    return;
                }

                body.innerHTML = await response.text();
            } catch {
                body.textContent = 'No se pudo conectar para cargar el detalle.';
            }
        });
    });
</script>

@if (Model.PriceHistory.Count == 0)
{
    <p class="text-muted">
        @(Model.IsProductHistory
            ? "Este producto todavía no tiene cambios de precio registrados."
            : "No hay cambios de precios registrados.")
    </p>
}
