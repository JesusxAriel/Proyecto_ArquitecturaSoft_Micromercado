@page
@model Proyecto_Arquitectura_Micromercado.Pages.Products.HistoryModel
@{
    ViewData["Title"] = "Historial de Precios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-heading mb-0">Historial de Precios</h1>
        @if (Model.IsProductHistory)
        {
            <p class="text-muted mb-0">Producto: @Model.ProductName</p>
        }
    </div>
    <a asp-page="/Products/Index" class="btn btn-outline-primary">
        <i class="bi bi-box-seam me-1"></i>Volver a Productos
    </a>
</div>

<form method="get" asp-page="/Products/History" class="row g-2 align-items-end mb-4">
    <div class="col-md-6 col-lg-4">
        <label for="productHistoryId" class="form-label">Consultar historial de precios</label>
        <select id="productHistoryId" name="id" class="form-select" onchange="this.form.submit()">
            <option value="" selected="@(Model.ProductId is null)">Todos los productos</option>
            @foreach (var product in Model.Products)
            {
                <option value="@product.Id" selected="@(Model.ProductId == product.Id)">
                    @product.Nombre
                </option>
            }
        </select>
    </div>
    <noscript>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Consultar</button>
        </div>
    </noscript>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="sticky-table-header">
            <tr>
                <th>Producto</th>
                <th>Precio Venta Ant. <span class="th-unit">(Bs)</span></th>
                <th>Precio Venta Nuevo <span class="th-unit">(Bs)</span></th>
                <th>Precio Costo Ant. <span class="th-unit">(Bs)</span></th>
                <th>Precio Costo Nuevo <span class="th-unit">(Bs)</span></th>
                <th>Motivo de Cambio</th>
                <th>Usuario</th>
                <th>Fecha de Cambio</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var change in Model.PriceHistory)
        {
            <tr>
                <td>@change.NombreProducto</td>
                <td>@change.PrecioVentaAnterior.ToString("N2")</td>
                <td>@change.PrecioVentaNuevo.ToString("N2")</td>
                <td>
                    @(change.PrecioCostoAnterior.HasValue
                        ? change.PrecioCostoAnterior.Value.ToString("N2")
                        : "—")
                </td>
                <td>
                    @(change.PrecioCostoNuevo.HasValue
                        ? change.PrecioCostoNuevo.Value.ToString("N2")
                        : "—")
                </td>
                <td>@change.MotivoCambio</td>
                <td>@change.IdUsuario</td>
                <td>@change.FechaCambio.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.PriceHistory.Count == 0)
{
    <p class="text-muted">
        @(Model.IsProductHistory
            ? "Este producto todavía no tiene cambios de precio registrados."
            : "No hay cambios de precios registrados.")
    </p>
}
