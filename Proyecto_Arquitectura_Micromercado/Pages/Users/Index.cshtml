@page
@model Proyecto_Arquitectura_Micromercado.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<h1 class="page-heading mb-4">Administración de usuarios</h1>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success shadow-sm" role="status">
        @Model.StatusMessage
        @if (!string.IsNullOrWhiteSpace(Model.UsernameGenerado))
        {
            <span>Username generado: <strong>@Model.UsernameGenerado</strong>.</span>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger shadow-sm" role="alert">@Model.ErrorMessage</div>
}

<section class="card shadow-sm mb-4" aria-labelledby="crearUsuarioTitulo">
    <div class="card-body">
        <h2 class="h5 card-title mb-3" id="crearUsuarioTitulo">Crear usuario</h2>
        <form method="post" asp-page-handler="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Nombre" class="form-label"></label>
                    <input asp-for="NuevoUsuario.Nombre" class="form-control" autocomplete="given-name" required />
                    <span asp-validation-for="NuevoUsuario.Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Apellido" class="form-label"></label>
                    <input asp-for="NuevoUsuario.Apellido" class="form-control" autocomplete="family-name" required />
                    <span asp-validation-for="NuevoUsuario.Apellido" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.Correo" class="form-label"></label>
                    <input asp-for="NuevoUsuario.Correo" type="email" class="form-control" autocomplete="email" required />
                    <span asp-validation-for="NuevoUsuario.Correo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NuevoUsuario.IdRol" class="form-label"></label>
                    <select asp-for="NuevoUsuario.IdRol" class="form-select" required>
                        <option value="">Seleccione un rol</option>
                        @foreach (var rol in Model.RolesActivos)
                        {
                            <option value="@rol.Id">@rol.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="NuevoUsuario.IdRol" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <p class="text-muted small">El username se genera automáticamente al crear el usuario.</p>
                    @if (Model.RolesActivos.Count > 0)
                    {
                        <button type="submit" class="btn btn-warning fw-semibold">Crear usuario</button>
                    }
                    else
                    {
                        <p class="text-danger mb-0">No hay roles activos disponibles para crear usuarios.</p>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

<section aria-labelledby="listadoUsuariosTitulo">
    <h2 class="h5 mb-3" id="listadoUsuariosTitulo">Listado de usuarios</h2>
    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="sticky-table-header">
                <tr>
                    <th scope="col">Nombre</th>
                    <th scope="col">Apellido</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Username</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Fecha de creación</th>
                    <th scope="col">Vence</th>
                    <th scope="col">Activada el</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Usuarios)
                {
                    <tr>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Apellido</td>
                        <td>@usuario.Correo</td>
                        <td>@usuario.Username</td>
                        <td>@usuario.Rol</td>
                        <td>
                            @usuario.Estado
                            @if (usuario.EstaExpirado)
                            {
                                <span class="badge bg-danger">Expirado</span>
                            }
                        </td>
                        <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(usuario.TokenActivacionExpira?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td>@(usuario.FechaActivacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                        <td class="text-nowrap">
                            @if (usuario.Estado == "PENDIENTE")
                            {
                                <form method="post" asp-page-handler="ReenviarActivacion" class="d-inline">
                                    <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Reenviar activación</button>
                                </form>
                            }
                            @if (usuario.Estado is "ACTIVO" or "PENDIENTE")
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#bajaUsuarioModal"
                                        data-usuario-id="@usuario.Id" data-usuario-nombre="@usuario.Nombre @usuario.Apellido"
                                        data-usuario-username="@usuario.Username">Dar de baja</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Usuarios.Count == 0 && Model.ErrorMessage is null)
    {
        <div class="alert alert-info mt-3">No hay usuarios registrados.</div>
    }
</section>

<div class="modal fade" id="bajaUsuarioModal" tabindex="-1" aria-labelledby="bajaUsuarioTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Desactivar">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="bajaUsuarioTitulo">Dar de baja usuario</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Desea dar de baja a este usuario?</p>
                    <p>Nombre: <strong id="bajaUsuarioNombre"></strong></p>
                    <p>Username: <strong id="bajaUsuarioUsername"></strong></p>
                    <input type="hidden" name="usuarioId" id="bajaUsuarioId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger" id="bajaUsuarioConfirmar" disabled>Dar de baja</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const bajaModal = document.getElementById('bajaUsuarioModal');
        const bajaId = document.getElementById('bajaUsuarioId');
        const bajaConfirmar = document.getElementById('bajaUsuarioConfirmar');
        bajaModal.addEventListener('show.bs.modal', function (event) {
            const boton = event.relatedTarget;
            bajaId.value = boton?.dataset.usuarioId ?? '';
            document.getElementById('bajaUsuarioNombre').textContent = boton?.dataset.usuarioNombre ?? '';
            document.getElementById('bajaUsuarioUsername').textContent = boton?.dataset.usuarioUsername ?? '';
            bajaConfirmar.disabled = !bajaId.value;
        });
        bajaModal.addEventListener('hidden.bs.modal', function () {
            bajaId.value = '';
            bajaConfirmar.disabled = true;
        });
    </script>
}
