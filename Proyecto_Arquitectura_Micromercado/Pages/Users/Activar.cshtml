@page
@model Proyecto_Arquitectura_Micromercado.Pages.Users.ActivarModel
@{
    ViewData["Title"] = "Activar cuenta";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @if (Model.ActivacionCompleta)
            {
                <h1 class="h4 fw-bold text-center mb-3">Cuenta activada</h1>
                <p class="text-center">Ya puedes iniciar sesión con tu correo y la contraseña que acabas de definir.</p>
                <a asp-page="/Login" class="btn btn-primary w-100">Ir al inicio de sesión</a>
            }
            else if (Model.TokenInvalido)
            {
                <h1 class="h4 fw-bold text-center mb-3">Enlace inválido o vencido</h1>
                <p class="text-center">El enlace de activación no es válido, ya fue utilizado o venció. Solicita un nuevo enlace al administrador.</p>
            }
            else
            {
                <h1 class="h4 fw-bold text-center mb-3">Activar cuenta</h1>
                <p class="text-muted text-center small mb-4">Define una contraseña segura para completar la activación.</p>
                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Contrasena" class="form-label"></label>
                        <input asp-for="Input.Contrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Contrasena" class="text-danger small"></span>
                        <div class="form-text">Mínimo 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial.</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmarContrasena" class="form-label"></label>
                        <input asp-for="Input.ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmarContrasena" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Activar cuenta</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
